@model IEnumerable<PixelUI.Models.Db.Order>

@{
    ViewData["Title"] = "Financial Overview";
    Layout = null;
    var role = Context.Session.GetString("UserRole");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/create-product.css">
    <link rel="stylesheet" href="~/css/manage-products.css">
    <style>
        /* ใช้สไตล์เดียวกับหน้า Analytics */
        html, body { height: 100%; margin: 0; overflow: hidden; background-color: #050505; color: white; }
        .browse-page-wrapper { display: flex; height: 100vh; }
        .main-content { flex: 1; overflow-y: auto; padding: 40px 60px;  }

        .kpi-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            padding: 20px;
            text-align: center;
            margin-bottom: 20px;
            transition: 0.3s ease;
        }
        .kpi-card:hover {
            background: rgba(255, 255, 255, 0.05);
            border-color: #7C3AED;
            transform: translateY(-5px);
        }
        .kpi-value { font-size: 2.5rem; font-weight: 700; margin: 10px 0; }
        .kpi-label { color: #a0a0a0; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 1px; }

        /* การจัดวางสัดส่วน License ให้ดู Modern */
        .license-stat-box {
            background: rgba(124, 58, 237, 0.05);
            border: 1px solid rgba(124, 58, 237, 0.1);
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 30px;
        }

        .payout-status { padding: 5px 12px; border-radius: 5px; font-size: 0.75rem; font-weight: 600; border: 1px solid; display: inline-block; }
        .status-paid { background: rgba(16, 185, 129, 0.1); color: #10b981; border-color: #10b981; }
        .status-commercial { background: rgba(236, 72, 153, 0.1); color: #ec4899; border-color: #ec4899; }
        .status-personal { background: rgba(13, 110, 253, 0.1); color: #0d6efd; border-color: #0d6efd; }
        .status-standard { background: rgba(255, 193, 7, 0.1); color: #ffc107; border-color: #ffc107; }
        .status-na { background: rgba(255, 255, 255, 0.05); color: #888; border-color: #333; }

        .main-content::-webkit-scrollbar { width: 6px; }
        .main-content::-webkit-scrollbar-thumb { background: #222; border-radius: 10px; }
    </style>
</head>

<body>
    <div class="browse-page-wrapper">
        <aside class="sidebar">
            <a href="/" class="sidebar-brand">PixelUI<span class="Text_Admin">Admin</span></a>
            <ul class="nav-menu">

        @* SuperAdmin เท่านั้น *@
        @if (role == "SuperAdmin")
        {
            <li><i class="bi bi-person"></i><a href="/Admin/Userlist">User Management</a></li>
            <li><i class="bi bi-sliders"></i><a href="/Admin/ManageStaffRoles">Manage Roles</a></li>
            <li class="active"><i class="bi bi-wallet2"></i><a href="/Admin/FinancialOverview">Financial Overview</a></li>
        }

        @* Product Manager + SuperAdmin *@
        @if (role == "SuperAdmin" || role == "Product Manager")
        {
            <li><i class="bi bi-plus-circle"></i><a href="/Admin/CreateProduct">Add Product</a></li>
            <li><i class="bi bi-boxes"></i><a href="/Admin/ManageProducts">Manage Products</a></li>
            <li><i class="bi bi-check-circle"></i><a href="/Admin/QCApprove">QC & Approve</a></li>
        }

        @* Marketing + SuperAdmin *@
        @if (role == "SuperAdmin" || role == "Marketing")
        {
            <li><i class="bi bi-graph-up"></i><a href="/Admin/Analytics">Analytics</a></li>
            <li><i class="bi bi-tag"></i><a href="/Admin/ManagePromotions">Promotions</a></li>
        }

        @* Customer Support + SuperAdmin *@
        @if (role == "SuperAdmin" || role == "Customer Support")
        {
            <li><i class="bi bi-ticket"></i><a href="/Admin/Tickets">Support Tickets</a></li>
            <li><i class="bi bi-check-circle"></i><a href="/Admin/StudentVerification">Student Verify</a></li>
        }

    </ul>
        </aside>

        <main class="main-content">
            <div class="admin-header">
                <div class="header-content">
                    <h1><i class="bi bi-wallet2"></i> Financial Overview</h1>
                    <p>Real-time insights into your platform revenue</p>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="kpi-card">
                        <div class="kpi-label"><i class="bi bi-currency-dollar"></i> Total Revenue</div>
                        <div class="kpi-value" style="color: white;">$@ViewBag.TotalRevenue.ToString("N2")</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="kpi-card">
                        <div class="kpi-label"><i class="bi bi-receipt"></i> Total Transactions</div>
                        <div class="kpi-value" style="color: #38bdf8;">@ViewBag.OrderCount</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="kpi-card">
                        <div class="kpi-label"><i class="bi bi-piggy-bank"></i> Est. Payout (90%)</div>
                        <div class="kpi-value" style="color: #7C3AED;">$@ViewBag.PendingPayout.ToString("N2")</div>
                    </div>
                </div>
            </div>

            <div class="license-stat-box">
                <div class="kpi-label mb-4"><i class="bi bi-pie-chart-fill me-2"></i>License Sales Distribution</div>
                <div class="row text-center">
                    <div class="col-4">
                        <span class="payout-status status-personal mb-2">Personal</span>
                        <h3 class="mt-2 fw-bold">@ViewBag.PersonalCount</h3>
                    </div>
                    <div class="col-4 border-start border-end border-secondary border-opacity-25">
                        <span class="payout-status status-standard mb-2">Standard</span>
                        <h3 class="mt-2 fw-bold">@ViewBag.StandardCount</h3>
                    </div>
                    <div class="col-4">
                        <span class="payout-status status-commercial mb-2">Commercial</span>
                        <h3 class="mt-2 fw-bold">@ViewBag.CommercialCount</h3>
                    </div>
                </div>
            </div>

            <div class="admin-header mt-5 mb-3">
                <div class="header-content">
                    <h3 style="font-weight: 600; color: #ffffff;">Recent Transactions</h3>
                </div>
            </div>

            <div class="products-table-container">
                <table class="products-table">
                    <thead>
                        <tr>
                            <th>ORDER ID</th>
                            <th>CUSTOMER</th>
                            <th>PRODUCT</th>
                            <th class="text-center">LICENSE</th>
                            <th class="text-center">AMOUNT</th>
                            <th class="text-center">STATUS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            var licenseClass = order.LicenseType switch {
                                "Personal" => "status-personal",
                                "Standard" => "status-standard",
                                "Commercial" => "status-commercial",
                                _ => "status-na"
                            };

                            <tr>
                                <td><code style="color: #a78bfa; font-size: 0.9rem;">#@order.OrderId</code></td>
                                <td>@(order.User?.Username ?? "Guest")</td>
                                <td><strong>@(order.Product?.ProductName ?? "Unknown Product")</strong></td>
                                <td class="text-center">
                                    <span class="payout-status @licenseClass">
                                        @(order.LicenseType ?? "N/A")
                                    </span>
                                </td>
                                <td class="text-center" style="color: #38bdf8; font-weight: 700;">$@(order.FinalPrice?.ToString("F2") ?? "0.00")</td>
                                <td class="text-center">
                                    <span class="payout-status status-paid">
                                        <i class="bi bi-patch-check-fill me-1"></i> PAID
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </main>
    </div>
</body>
</html>