@model List<Promotion>

@{
    ViewData["Title"] = "Manage Promotions";
    Layout = null;
    var role = Context.Session.GetString("UserRole");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/create-product.css">
    <link rel="stylesheet" href="~/css/manage-products.css">
    <style>
        .promotion-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 15px;
            transition: all 0.3s ease;
        }
        .promotion-card:hover {
            border-color: #7C3AED;
            background: rgba(124, 58, 237, 0.05);
        }
        .promotion-header {
            display: flex;
            justify-content: space-between;
            align-items: start;
            margin-bottom: 15px;
        }
        .promo-code {
            font-family: 'Courier New', monospace;
            background: rgba(124, 58, 237, 0.1);
            border: 1px solid rgba(124, 58, 237, 0.3);
            border-radius: 5px;
            padding: 8px 12px;
            color: #7C3AED;
            font-weight: 700;
            font-size: 0.95rem;
        }
        .promo-type-badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 5px;
            font-size: 0.8rem;
            font-weight: 600;
            margin-right: 10px;
        }
        .badge-starter {
            background: rgba(34, 197, 94, 0.2);
            color: #22c55e;
        }
        .badge-bundle {
            background: rgba(59, 130, 246, 0.2);
            color: #3b82f6;
        }
        .badge-subscription {
            background: rgba(245, 158, 11, 0.2);
            color: #f59e0b;
        }
        .badge-student {
            background: rgba(168, 85, 247, 0.2);
            color: #a855f7;
        }
        .badge-update {
            background: rgba(236, 72, 153, 0.2);
            color: #ec4899;
        }
        .status-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 0.8rem;
            font-weight: 600;
        }
        .status-active {
            background: rgba(34, 197, 94, 0.2);
            color: #22c55e;
        }
        .status-inactive {
            background: rgba(156, 163, 175, 0.2);
            color: #d1d5db;
        }
        .status-expired {
            background: rgba(239, 68, 68, 0.2);
            color: #ef4444;
        }
        .promo-details {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 15px;
        }
        .detail-item {
            display: flex;
            flex-direction: column;
        }
        .detail-label {
            color: #a0a0a0;
            font-size: 0.85rem;
            margin-bottom: 4px;
        }
        .detail-value {
            color: #e0e0e0;
            font-weight: 500;
        }
        .action-buttons {
            display: flex;
            gap: 10px;
            justify-content: flex-end;
        }
        .btn-edit, .btn-delete {
            padding: 6px 12px;
            border-radius: 5px;
            font-size: 0.85rem;
            border: none;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all 0.3s ease;
            text-decoration: none;
        }
        .btn-edit {
            background: rgba(124, 58, 237, 0.2);
            color: #7C3AED;
            border: 1px solid rgba(124, 58, 237, 0.3);
        }
        .btn-edit:hover {
            background: #7C3AED;
            color: white;
        }
        .btn-delete {
            background: rgba(239, 68, 68, 0.2);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.3);
        }
        .btn-delete:hover {
            background: #ef4444;
            color: white;
        }
        .create-btn {
            background: #7C3AED;
            color: white;
            padding: 10px 24px;
            border: none;
            border-radius: 5px;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            transition: background 0.3s ease;
        }
        .create-btn:hover {
            background: #6d28d9;
            color: white;
        }
        .success-message {
            background: rgba(34, 197, 94, 0.1);
            border: 1px solid #22c55e;
            color: #22c55e;
            padding: 12px 16px;
            border-radius: 5px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .empty-state {
            text-align: center;
            padding: 50px 20px;
            color: #a0a0a0;
        }
        .empty-state i {
            font-size: 3rem;
            color: #7C3AED;
            margin-bottom: 15px;
            display: block;
        }
        .filters {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }
        .filter-btn {
            padding: 6px 12px;
            border-radius: 5px;
            border: 1px solid #333;
            background: #1a1a1c;
            color: #a0a0a0;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 0.9rem;
        }
        .filter-btn.active {
            background: #7C3AED;
            color: white;
            border-color: #7C3AED;
        }
    </style>
</head>
<body>
    <div class="browse-page-wrapper">
        <aside class="sidebar">
            <a href="/" class="sidebar-brand">PixelUI<span class="Text_Admin">Admin</span></a>
           <ul class="nav-menu">

        @* SuperAdmin เท่านั้น *@
        @if (role == "SuperAdmin")
        {
            <li><i class="bi bi-person"></i><a href="/Admin/Userlist">User Management</a></li>
            <li><i class="bi bi-sliders"></i><a href="/Admin/ManageStaffRoles">Manage Roles</a></li>
            <li><i class="bi bi-wallet2"></i><a href="/Admin/FinancialOverview">Financial Overview</a></li>
        }

        @* Product Manager + SuperAdmin *@
        @if (role == "SuperAdmin" || role == "Product Manager")
        {
            <li><i class="bi bi-plus-circle"></i><a href="/Admin/CreateProduct">Add Product</a></li>
            <li><i class="bi bi-boxes"></i><a href="/Admin/ManageProducts">Manage Products</a></li>
            <li><i class="bi bi-check-circle"></i><a href="/Admin/QCApprove">QC & Approve</a></li>
        }

        @* Marketing + SuperAdmin *@
        @if (role == "SuperAdmin" || role == "Marketing")
        {
            <li><i class="bi bi-graph-up"></i><a href="/Admin/Analytics">Analytics</a></li>
            <li class="active"><i class="bi bi-tag"></i><a href="/Admin/ManagePromotions">Promotions</a></li>
        }

        @* Customer Support + SuperAdmin *@
        @if (role == "SuperAdmin" || role == "Customer Support")
        {
            <li><i class="bi bi-ticket"></i><a href="/Admin/Tickets">Support Tickets</a></li>
            <li><i class="bi bi-check-circle"></i><a href="/Admin/StudentVerification">Student Verify</a></li>
        }

    </ul>
        </aside>

        <main class="main-content">
            <div class="modal-overlay">
                <div class="admin-container">
                    <div class="admin-header">
                        <div class="header-content">
                            <h1><i class="bi bi-tag"></i> Promotion Manager</h1>
                            <p>Create and manage discount codes and promotional offers</p>
                        </div>
                        <a href="/Admin/CreatePromotion" class="create-btn">
                            <i class="bi bi-plus-circle"></i> Create New Promotion
                        </a>
                    </div>

                    <!-- Success Message -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="success-message">
                            <i class="bi bi-check-circle"></i>
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    <!-- Filters -->
                    <div class="filters">
                        <button class="filter-btn active" onclick="filterByStatus('all')">
                            <i class="bi bi-funnel"></i> All Promotions
                        </button>
                        <button class="filter-btn" onclick="filterByStatus('Active')">
                            <i class="bi bi-check-circle"></i> Active
                        </button>
                        <button class="filter-btn" onclick="filterByStatus('Inactive')">
                            <i class="bi bi-pause-circle"></i> Inactive
                        </button>
                        <button class="filter-btn" onclick="filterByType('StarterPack')">
                            <i class="bi bi-rocket"></i> Starter Pack
                        </button>
                        <button class="filter-btn" onclick="filterByType('BundleDeal')">
                            <i class="bi bi-box-seam"></i> Bundle Deal
                        </button>
                        <button class="filter-btn" onclick="filterByType('MonthlyPromo')">
                            <i class="bi bi-box-seam"></i> Monthly Promo
                        </button>
                        <button class="filter-btn" onclick="filterByType('StudentLicense')">
                            <i class="bi bi-mortarboard"></i> Student License
                    </div>

                    <!-- Promotions List -->
                    @if (Model?.Any() == true)
                    {
                        @foreach (var promo in Model)
                        {
                            var statusClass = promo.Status switch
                            {
                                "Active" => "status-active",
                                "Inactive" => "status-inactive",
                                _ => "status-expired"
                            };

                            var typeClass = promo.PromotionType switch
                            {
                                "StarterPack" => "badge-starter",
                                "BundleDeal" => "badge-bundle",
                                "MonthlyPromo" => "badge-subscription",
                                "StudentLicense" => "badge-student",
                                "UpdateGuarantee" => "badge-update",
                                _ => ""
                            };

                            var isExpired = promo.ExpiryDate.HasValue && promo.ExpiryDate < DateTime.Now;

                            <div class="promotion-card" data-status="@promo.Status" data-type="@promo.PromotionType">
                                <div class="promotion-header">
                                    <div>
                                        @if (!string.IsNullOrEmpty(promo.PromoCode))
{
    <span class="promo-code">@promo.PromoCode</span>
}
else if (promo.PromotionType == "BundleDeal")
{
    <span class="promo-code" style="opacity:0.6;">-</span>
}
                                        <span class="promo-type-badge @typeClass">
                                            @promo.PromotionType
                                        </span>
                                        <span class="status-badge @statusClass">
                                            @(isExpired ? "Expired" : promo.Status)
                                        </span>
                                    </div>
                                    <div style="text-align: right;"></div>
                                </div>

                                <div class="promo-details">
                                    <div class="detail-item">
                                        <span class="detail-label"><i class="bi bi-percent"></i> Discount</span>
                                        <span class="detail-value">@promo.DiscountPct%</span>
                                    </div>

                                    <div class="detail-item">
                                        <span class="detail-label"><i class="bi bi-calendar-event"></i> Valid From</span>
                                        <span class="detail-value">@promo.StartDate?.ToString("MMM dd, yyyy")</span>
                                    </div>

                                    <div class="detail-item">
                                        <span class="detail-label"><i class="bi bi-calendar-x"></i> Expires</span>
                                        <span class="detail-value">@promo.ExpiryDate?.ToString("MMM dd, yyyy")</span>
                                    </div>

                                    <div class="detail-item">
                                        <span class="detail-label"><i class="bi bi-counter"></i> Usage / Limit</span>
                                        <span class="detail-value">@promo.CurrentUsageCount / @(promo.MaxUsageCount?.ToString() ?? "Unlimited")</span>
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(promo.Description))
                                {
                                    <div style="margin-bottom: 15px; color: #a0a0a0; font-size: 0.95rem;">
                                        <i class="bi bi-justify"></i> @promo.Description
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(promo.Conditions))
                                {
                                    <div style="margin-bottom: 15px; background: rgba(124, 58, 237, 0.05); padding: 10px; border-radius: 5px; border-left: 3px solid #7C3AED;">
                                        <small style="color: #a0a0a0;"><i class="bi bi-info-circle"></i> Conditions:</small>
                                        <div style="color: #e0e0e0;">@promo.Conditions</div>
                                    </div>
                                }

                                @if (promo.PromotionType == "BundleDeal" && !string.IsNullOrEmpty(promo.BundleProductIds))
                                {
                                    <div style="margin-bottom: 15px; background: rgba(124, 58, 237, 0.05); padding: 10px; border-radius: 5px; border-left: 3px solid #7C3AED;">
                                        <small style="color: #a0a0a0;"><i class="bi bi-box-seam"></i> Bundle Products:</small>
                                        <div style="color: #e0e0e0;">@promo.BundleProductIds</div>
                                    </div>
                                }

                                <div class="action-buttons">
                                    <a href="/Admin/EditPromotion/@promo.PromotionId" class="btn-edit">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                    <button type="button" class="btn-delete" onclick="confirmDelete(@promo.PromotionId, '@promo.PromoCode')">
                                        <i class="bi bi-trash"></i> Delete
                                    </button>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-inbox"></i>
                            <h3>No Promotions Yet</h3>
                            <p>Create your first promotion to get started!</p>
                            <a href="/Admin/CreatePromotion" class="create-btn" style="margin-top: 20px;">
                                <i class="bi bi-plus-circle"></i> Create Promotion
                            </a>
                        </div>
                    }
                </div>
            </div>
        </main>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); z-index: 9999; align-items: center; justify-content: center;">
        <div style="background: #1a1a1c; border: 1px solid #333; border-radius: 10px; padding: 30px; max-width: 400px; text-align: center;">
            <h3 style="color: #ef4444; margin-bottom: 15px;">
                <i class="bi bi-exclamation-triangle"></i> Delete Promotion?
            </h3>
            <p id="deleteMessage" style="color: #a0a0a0; margin-bottom: 20px;"></p>
            <div style="display: flex; gap: 10px; justify-content: center;">
                <button onclick="confirmDeleteAction()" style="background: #ef4444; color: white; border: none; padding: 8px 20px; border-radius: 5px; cursor: pointer; font-weight: 600;">
                    Delete
                </button>
                <button onclick="cancelDelete()" style="background: #333; color: #e0e0e0; border: 1px solid #555; padding: 8px 20px; border-radius: 5px; cursor: pointer; font-weight: 600;">
                    Cancel
                </button>
            </div>
        </div>
    </div>

    <script>
        let deletePromoId = null;

        function confirmDelete(id, code) {
            deletePromoId = id;
            document.getElementById('deleteMessage').textContent = `Are you sure you want to delete the promotion "${code}"? This action cannot be undone.`;
            document.getElementById('deleteModal').style.display = 'flex';
        }

        function cancelDelete() {
            deletePromoId = null;
            document.getElementById('deleteModal').style.display = 'none';
        }

        function confirmDeleteAction() {
            if (deletePromoId) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = `/Admin/DeletePromotion/${deletePromoId}`;
                document.body.appendChild(form);
                form.submit();
            }
        }

        function filterByStatus(status) {
            const cards = document.querySelectorAll('.promotion-card');
            cards.forEach(card => {
                if (status === 'all' || card.dataset.status === status) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });

            // Update filter buttons
            document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
        }

        function filterByType(type) {
            const cards = document.querySelectorAll('.promotion-card');
            cards.forEach(card => {
                if (card.dataset.type === type) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });

            // Update filter buttons
            document.querySelectorAll('.filter-btn').forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');
        }
    </script>
</body>
</html>
