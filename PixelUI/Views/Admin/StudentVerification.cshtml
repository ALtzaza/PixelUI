@model IEnumerable<StudentVerification>

@{
    Layout = null;
    var role = Context.Session.GetString("UserRole");
}

<!DOCTYPE html>
<html>

<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/create-product.css">
    <link rel="stylesheet" href="~/css/manage-products.css">

    <style>
            .preview-img {
                width: 80px;
                border-radius: 8px;
                cursor: pointer;
                transition: 0.3s;
            }

            .preview-img:hover {
                transform: scale(1.1);
                box-shadow: 0 0 10px rgba(124, 58, 237, 0.7);
            }

            /* Modal */
            .image-modal {
                display: none;
                position: fixed;
                z-index: 9999;
                left: 0;
                top: 0;
                width: 100%;
                height: 100%;
                background: rgba(0, 0, 0, 0.9);
                justify-content: center;
                align-items: center;
            }

            .image-modal img {
                max-width: 80%;
                max-height: 80%;
                border-radius: 12px;
                box-shadow: 0 0 30px rgba(124, 58, 237, 0.8);
            }

            .image-modal.active {
                display: flex;
            }

            .main-content {
    flex: 1;
    overflow-y: auto;
    padding: 40px 60px;
}

/* card */
.verify-card {
    background: #0b0b0c;
    border: 1px solid #221a2b;
    border-radius: 12px;
    padding: 22px;
    color: #ddd;
}

/* toolbar */
.verify-toolbar {
    display:flex;
    gap:12px;
    align-items:center;
    margin-bottom:18px;
}

.verify-search {
    background:#111;
    border:1px solid #222;
    color:#ddd;
    padding:8px 12px;
    border-radius:8px;
}

/* table */
.products-table {
    width:100%;
    border-collapse:separate;
    border-spacing:0 10px;
}

.products-table tbody tr {
    background: linear-gradient(180deg, rgba(16,12,18,0.6), rgba(8,8,10,0.6));
    border-radius:10px;
}
    </style>
</head>

<body>


    <div class="browse-page-wrapper">

        <!-- Sidebar -->
        <aside class="sidebar">
            <a href="/" class="sidebar-brand">PixelUI<span class="Text_Admin">Admin</span></a>
            <ul class="nav-menu">

        @* SuperAdmin เท่านั้น *@
        @if (role == "SuperAdmin")
        {
            <li><i class="bi bi-person"></i><a href="/Admin/Userlist">User Management</a></li>
            <li><i class="bi bi-sliders"></i><a href="/Admin/ManageStaffRoles">Manage Roles</a></li>
            <li><i class="bi bi-wallet2"></i><a href="/Admin/FinancialOverview">Financial Overview</a></li>
        }

        @* Product Manager + SuperAdmin *@
        @if (role == "SuperAdmin" || role == "Product Manager")
        {
            <li><i class="bi bi-plus-circle"></i><a href="/Admin/CreateProduct">Add Product</a></li>
            <li><i class="bi bi-boxes"></i><a href="/Admin/ManageProducts">Manage Products</a></li>
            <li><i class="bi bi-check-circle"></i><a href="/Admin/QCApprove">QC & Approve</a></li>
        }

        @* Marketing + SuperAdmin *@
        @if (role == "SuperAdmin" || role == "Marketing")
        {
            <li><i class="bi bi-graph-up"></i><a href="/Admin/Analytics">Analytics</a></li>
            <li><i class="bi bi-tag"></i><a href="/Admin/ManagePromotions">Promotions</a></li>
        }

        @* Customer Support + SuperAdmin *@
        @if (role == "SuperAdmin" || role == "Customer Support")
        {
            <li><i class="bi bi-ticket"></i><a href="/Admin/Tickets">Support Tickets</a></li>
            <li class="active"><i class="bi bi-check-circle"></i><a href="/Admin/StudentVerification">Student Verify</a></li>
        }

    </ul>
                </aside>
                <!-- Main -->
                <main class="main-content">

                    <div class="admin-header">
                        <div class="header-content">
                            <h1><i class="bi bi-mortarboard"></i> Student Verification</h1>
                            <p>Approve or reject student requests</p>
                        </div>
                    </div>

                    <div class="products-table-container">
                        @if (Model != null && Model.Any())
                        {
                            <div class="verify-card">

                                <div class="verify-toolbar">
                                    <input type="text" class="verify-search" placeholder="Search student..." />


                                </div>
                                <table class="products-table">
                                    <thead>
                                        <tr>
                                            <th>User</th>
                                            <th>Student ID</th>
                                            <th>University</th>
                                            <th>Proof</th>
                                            <th>Status</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@item.User?.Username</strong>
                                                </td>

                                                <td>@item.StudentId</td>

                                                <td>@item.University</td>

                                                <td>
                                                    <img src="@item.ProofImage" class="preview-img"
                                                         onclick="openImageModal(this.src)" />
                                                </td>

                                                <td>
                                                    @if (item.Status == "Pending")
                                                    {
                                                        <span class="badge-pending">Pending</span>
                                                    }
                                                    else if (item.Status == "Approved")
                                                    {
                                                        <span class="badge-resolved">Approved</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge-hidden">@item.Status</span>
                                                    }
                                                </td>

                                                <td>
                                                    @if (item.Status == "Pending")
                                                    {
                                                        <div class="action-buttons">

                                                            <form asp-action="ApproveStudent" method="post">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@item.Id" />
                                                                <button class="btn-edit">
                                                                    <i class="bi bi-check-circle"></i> Approve
                                                                </button>
                                                            </form>

                                                            <form asp-action="RejectStudent" method="post">
                                                                @Html.AntiForgeryToken()
                                                                <input type="hidden" name="id" value="@item.Id" />
                                                                <button class="btn-delete">
                                                                    <i class="bi bi-x-circle"></i> Reject
                                                                </button>
                                                            </form>

                                                        </div>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        
                        else
                        {
                        <div style="text-align:center; padding:60px; color:#aaa;">
                            <i class="bi bi-inbox" style="font-size:60px;"></i>
                            <h4>No Student Verification</h4>
                            <p>You're all caught up! No students are waiting for approval.</p>
                        </div>
                        }

                    </div>

                </main>
            </div>

            <div id="imageModal" class="image-modal" onclick="closeImageModal()">
                <img id="modalImage" src="" />
            </div>

        </body>

        <script>
            function openImageModal(src) {
                document.getElementById("modalImage").src = src;
                document.getElementById("imageModal").classList.add("active");
            }

            function closeImageModal() {
                document.getElementById("imageModal").classList.remove("active");
            }
        </script>

    </html>