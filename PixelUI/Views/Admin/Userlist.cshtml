@using PixelUI.Models.Db
@model IEnumerable<PixelUI.Models.Db.User>

@{
    Layout = null;
    ViewData["Title"] = "User Management";
    var role = Context.Session.GetString("UserRole");
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/create-product.css">
    <link rel="stylesheet" href="~/css/manage-staff-roles.css">

</head>

<body>

    <div class="browse-page-wrapper">
        <aside class="sidebar">
            <a href="/" class="sidebar-brand">PixelUI<span class="Text_Admin">Admin</span></a>
             <ul class="nav-menu">

        @* SuperAdmin เท่านั้น *@
        @if (role == "SuperAdmin")
        {
            <li class="active"><i class="bi bi-person"></i><a href="/Admin/Userlist">User Management</a></li>
            <li><i class="bi bi-sliders"></i><a href="/Admin/ManageStaffRoles">Manage Roles</a></li>
            <li><i class="bi bi-wallet2"></i><a href="/Admin/FinancialOverview">Financial Overview</a></li>
        }

        @* Product Manager + SuperAdmin *@
        @if (role == "SuperAdmin" || role == "Product Manager")
        {
            <li><i class="bi bi-plus-circle"></i><a href="/Admin/CreateProduct">Add Product</a></li>
            <li><i class="bi bi-boxes"></i><a href="/Admin/ManageProducts">Manage Products</a></li>
            <li><i class="bi bi-check-circle"></i><a href="/Admin/QCApprove">QC & Approve</a></li>
        }

        @* Marketing + SuperAdmin *@
        @if (role == "SuperAdmin" || role == "Marketing")
        {
            <li><i class="bi bi-graph-up"></i><a href="/Admin/Analytics">Analytics</a></li>
            <li><i class="bi bi-tag"></i><a href="/Admin/ManagePromotions">Promotions</a></li>
        }

        @* Customer Support + SuperAdmin *@
        @if (role == "SuperAdmin" || role == "Customer Support")
        {
            <li><i class="bi bi-ticket"></i><a href="/Admin/Tickets">Support Tickets</a></li>
            <li><i class="bi bi-check-circle"></i><a href="/Admin/StudentVerification">Student Verify</a></li>
        }

    </ul>
        </aside>

                    <main class="main-content">
                        <div class="modal-overlay">
                            <div class="admin-container">
                                <div class="admin-header">
                                    <div class="header-content">
                                        <h1><i class="bi bi-person"></i> User Management</h1>
                                        <p>จัดการข้อมูลผู้ใช้งานในระบบ</p>
                                    </div>
                                </div>

                                <div class="staff-table-container">
                                    <table class="staff-table">
                                        <thead>
                                            <tr>
                                                <th>Username</th>
                                                <th>Email</th>
                                                <th>Current Role</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model != null && Model.Any())
                                            {
                                                foreach (var user in Model)
                                                {
                                                    <tr>
                                                        <td>
                                                            <strong>@user.Username</strong>
                                                        </td>
                                                        <td>@user.Email</td>
                                                        <td>
                                                            <span class="role-badge">@(user.Role?.RoleName ?? "No Role")</span>
                                                        </td>
                                                        <td>
                                                            <div class="action-buttons">
                                                                <a href="/Admin/EditUser/@user.UserId" class="btn-edit">
                                                                    <i class="bi bi-pencil"></i>
                                                                </a>
                                                                <form method="post" action="/Admin/DeleteUser/@user.UserId"
                                                                      style="display: inline;">
                                                                    <button type="submit" class="btn-delete"
                                                                            onclick="return confirm('Are you sure you want to delete this user?');">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="4" style="text-align: center; color: #888; padding: 30px;">
                                                        No users found in database.
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </main>
                </div>

            </body>

        </html>