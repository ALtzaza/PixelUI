@model PixelUI.Models.Db.Product
@{
    ViewData["Title"] = "Edit Product - " + Model.ProductName;
    Layout = null;
    string previewId = "preview-" + Model.ProductId;
    var role = Context.Session.GetString("UserRole");
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/create-product.css">
    <link rel="stylesheet" href="~/css/detail-page.css">
</head>

<body>

    <div class="browse-page-wrapper">
        <aside class="sidebar">
            <a href="/" class="sidebar-brand">PixelUI<span class="Text_Admin">Admin</span></a>
             <ul class="nav-menu">

        @* SuperAdmin เท่านั้น *@
        @if (role == "SuperAdmin")
        {
            <li ><i class="bi bi-person"></i><a href="/Admin/Userlist">User Management</a></li>
            <li><i class="bi bi-sliders"></i><a href="/Admin/ManageStaffRoles">Manage Roles</a></li>
            <li><i class="bi bi-wallet2"></i><a href="/Admin/FinancialOverview">Financial Overview</a></li>
        }

        @* Product Manager + SuperAdmin *@
        @if (role == "SuperAdmin" || role == "Product Manager")
        {
            <li ><i class="bi bi-plus-circle"></i><a href="/Admin/CreateProduct">Add Product</a></li>
            <li class="active"><i class="bi bi-boxes"></i><a href="/Admin/ManageProducts">Manage Products</a></li>
            <li><i class="bi bi-check-circle"></i><a href="/Admin/QCApprove">QC & Approve</a></li>
        }

        @* Marketing + SuperAdmin *@
        @if (role == "SuperAdmin" || role == "Marketing")
        {
            <li><i class="bi bi-graph-up"></i><a href="/Admin/Analytics">Analytics</a></li>
            <li><i class="bi bi-tag"></i><a href="/Admin/ManagePromotions">Promotions</a></li>
        }

        @* Customer Support + SuperAdmin *@
        @if (role == "SuperAdmin" || role == "Customer Support")
        {
            <li><i class="bi bi-ticket"></i><a href="/Admin/Tickets">Support Tickets</a></li>
            <li><i class="bi bi-check-circle"></i><a href="/Admin/StudentVerification">Student Verify</a></li>
        }

    </ul>
        </aside>

                <main class="main-content">
                    <form asp-controller="Admin" asp-action="EditProduct" method="post" id="productForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="ProductId" />
                        <input type="hidden" asp-for="Category" />

                        <div class="product-detail-container">
                            <div class="top-nav mb-4">
                                <a href="/Admin/ManageProducts" class="go-back-link">
                                    <i class="bi bi-arrow-left"></i> Back to Products
                                </a>
                                <button type="submit" class="submit-btn">
                                    <i class="bi bi-check-circle"></i> Save Changes
                                </button>
                            </div>

                            <div class="product-info-card mb-4">
                                <div class="product-header">
                                    <div>
                                        <input asp-for="ProductName" class="product-name"
                                               style="background:transparent; border:none; border-bottom: 1px solid #333; outline:none;"
                                               placeholder="Product Name" />
                                        <p class="product-category mt-2">
                                            <i class="bi bi-tag-fill"></i> @(Model.Category ?? "UI Component")
                                        </p>
                                    </div>
                                    <div class="product-price">
                                        <span class="price-label">Price (USD)</span>
                                        <input asp-for="BasePrice" type="number" step="0.01" class="price-input"
                                               style="background:transparent; border:none; color:#4387f4; font-size:24px; font-weight:700; width:120px; text-align:center; outline:none;" />
                                    </div>
                                </div>

                                <div class="product-specs">
                                    <div class="spec-item">
                                        <i class="bi bi-code-slash"></i>
                                        <div>
                                            <strong>Tech Stack</strong>
                                            <select asp-for="TechStack" class="spec-input"
                                                    style="background:transparent; border:none; color:#ccc; outline:none; cursor:pointer;">
                                                <option value="HTML & CSS">HTML & CSS</option>
                                                <option value="HTML & CSS & JavaScript">HTML & CSS & JavaScript</option>
                                                <option value="React">React</option>
                                                <option value="Tailwind CSS">Tailwind CSS</option>
                                            </select>
                                        </div>
                                    </div>
                            
                                    <div class="spec-item">
                                        <i class="bi bi-bar-chart"></i>
                                        <div>
                                            <strong>Complexity</strong>
                                            <input asp-for="ComplexityTier" type="range" min="1" max="5"
                                                   class="complexity-slider mt-2" id="complexitySlider"
                                                   style="accent-color:#7C3AED;" />
                                        </div>
                                    </div>

                                    <div class="spec-item">
                                        <i class="bi bi-person-circle"></i>
                                        <div>
                                            <strong>Designer</strong>
                                            <p>@(Model.Author ?? "Anonymous")</p>
                                            <input type="hidden" asp-for="Author" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="workspace">
                                <div class="preview-side" id="previewContainer">
                                    <div class="preview-tools">
                                        <div class="form-check form-switch d-inline-block ms-2">
                                            <input class="form-check-input" type="checkbox" id="modeSwitch">
                                            <i class="bi bi-brightness-high ms-1 text-white"></i>
                                        </div>
                                    </div>
                            
                                    <style id="dynamic-css">
                                                                    @Model.CssCode
                                    </style>
                                    <div id="@previewId" class="preview-content">
                                        @Html.Raw(Model.HtmlCode)
                                    </div>
                                </div>

                                <div class="code-side">
                                    <div class="code-tabs">
                                        <div class="btn-group">
                                            <button type="button" class="tab-btn active"
                                                    onclick="openTab(event, 'html-section')">
                                                <i class="bi bi-filetype-html text-danger"></i> HTML
                                            </button>
                                            <button type="button" class="tab-btn" onclick="openTab(event, 'css-section')">
                                                <i class="bi bi-filetype-css text-primary"></i> CSS
                                            </button>
                                        </div>
                                        <button type="button" class="copy-btn" id="copyBtn" onclick="copyActiveCode()">
                                            <i class="bi bi-clipboard"></i> Copy
                                        </button>
                                    </div>

                                    <div id="html-section" class="tab-content show">
                                        <textarea asp-for="HtmlCode" class="code-editor" id="html-raw"
                                                  spellcheck="false">@Model.HtmlCode</textarea>
                                    </div>

                                    <div id="css-section" class="tab-content">
                                        <textarea asp-for="CssCode" class="code-editor" id="css-raw"
                                                  spellcheck="false">@Model.CssCode</textarea>
                                    </div>
                                </div>
                            </div>
                            <!-- Description Edit Section -->
                            <div class="product-description-edit mt-5">

                                <div class="desc-grid">

                                    <!-- LEFT -->
                                    <div class="desc-left">
                                        <h3>Overview</h3>

                                        <textarea asp-for="Description" class="form-control dark-input" rows="5"
                                                  placeholder="Write product overview..."></textarea>

                                        <h5 class="mt-4">What's Included</h5>

                                        <textarea asp-for="IncludedItems" class="form-control dark-input" rows="5" placeholder="Example:
                                        - Responsive Design
                                        - Clean Code
                                        - Easy to Customize"></textarea>
                                    </div>

                                    <!-- RIGHT -->
                                    <div class="desc-right-card">
                                        <h3>Highlights</h3>

                                        <textarea asp-for="Highlights" class="form-control dark-input" rows="6" placeholder="Example:
                                        - High Quality UI
                                        - Ready to Use
                                        - Lightweight"></textarea>

                                        <div class="format-box mt-4">
                                            <h5>Format</h5>
                                            <input asp-for="Format" class="form-control dark-input"
                                                   placeholder="HTML / CSS / React" />
                                        </div>
                                    </div>

                                </div>

                            </div>
                        </div>
                    </form>
                </main>
            </div>

            <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
            <script>
                // Tab switching
                function openTab(evt, sectionId) {
                evt.preventDefault();
                const contents = document.getElementsByClassName("tab-content");
                for (let i = 0; i < contents.length; i++) contents[i].classList.remove("show");

                const btns = document.getElementsByClassName("tab-btn");
                for (let i = 0; i < btns.length; i++) btns[i].classList.remove("active");

                document.getElementById(sectionId).classList.add("show");
                evt.currentTarget.classList.add("active");
                }

                // Live Preview Update
                function updatePreview() {
                const htmlCode = document.getElementById('html-raw').value;
                const cssCode = document.getElementById('css-raw').value;
                const previewId = 'preview-@Model.ProductId';
                const previewContainer = document.getElementById(previewId);

                if (previewContainer) {
                previewContainer.innerHTML = htmlCode;
                }

                // ใช้ style เดิม ไม่ต้องสร้างใหม่
                const styleElement = document.getElementById('dynamic-css');
                styleElement.innerHTML = cssCode;
                }

                // Update preview when code is edited (only if user has purchased)
                const htmlEditor = document.getElementById('html-raw');
                const cssEditor = document.getElementById('css-raw');
    
                if (htmlEditor && !htmlEditor.disabled) {
                htmlEditor.addEventListener('input', updatePreview);
                }
                if (cssEditor && !cssEditor.disabled) {
                cssEditor.addEventListener('input', updatePreview);
                }

                // Listen for changes
                document.getElementById('html-raw').addEventListener('input', updatePreview);
                document.getElementById('css-raw').addEventListener('input', updatePreview);

                // Copy Code
                function copyActiveCode() {
                const isHtml = document.getElementById('html-section').classList.contains('show');
                const targetId = isHtml ? 'html-raw' : 'css-raw';
                const targetLabel = isHtml ? 'HTML' : 'CSS';
                const code = document.getElementById(targetId).value;

                navigator.clipboard.writeText(code).then(() => {
                const btn = document.getElementById('copyBtn');
                const original = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-check-lg text-success"></i> Copied!';
                setTimeout(() => { btn.innerHTML = original; }, 2000);
                });
                }

                // Dark/Light Mode Switch for Preview
                document.getElementById('modeSwitch').addEventListener('change', function () {
                const container = document.getElementById('previewContainer');
                container.style.backgroundColor = this.checked ? '#fff' : '#1a1a1a';
                });

                // Auto update preview on load
                window.onload = updatePreview;
            </script>
        </body>

    </html>