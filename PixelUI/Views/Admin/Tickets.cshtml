@model IEnumerable<PixelUI.Models.Db.Ticket>

@{
    Layout = null;
    var role = Context.Session.GetString("UserRole");
}

<!DOCTYPE html>
<html>

<head>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/create-product.css">
    <link rel="stylesheet" href="~/css/manage-products.css">

    <style>
            .main-content {
                flex: 1;
                overflow-y: auto;
                padding: 40px 60px;
            }
            /* Tickets page tweaks */
            .tickets-card {
                background: #0b0b0c;
                border: 1px solid #221a2b;
                border-radius: 12px;
                padding: 22px;
                color: #ddd;
            }

            .tickets-toolbar {
                display:flex;
                gap:12px;
                align-items:center;
                margin-bottom:18px;
                flex-wrap:wrap;
            }

            .tickets-search {
                background:#111;
                border:1px solid #222;
                color:#ddd;
                padding:8px 12px;
                border-radius:8px;
                min-width:240px;
            }

            .products-table {
                width:100%;
                border-collapse:separate;
                border-spacing:0 10px;
            }

            .products-table thead th {
                color:#bdb8c8;
                font-weight:600;
                font-size:0.95rem;
                padding:12px 18px;
                text-align:left;
            }

            .products-table tbody tr {
                background: linear-gradient(180deg, rgba(16,12,18,0.6), rgba(8,8,10,0.6));
                border:1px solid rgba(40,30,50,0.6);
                border-radius:10px;
            }

            .products-table tbody tr.selected {
                box-shadow: 0 0 0 2px rgba(124,58,237,0.35) inset;
            }

            .products-table tbody tr { cursor: pointer; }

            .products-table td {
                padding:14px 18px;
                vertical-align:middle;
                color:#d6d3df;
            }

            .badge-pending { background:#f59e0b; color:#111; padding:6px 10px; border-radius:999px; }
            .badge-resolved { background:#10b981; color:#051; padding:6px 10px; border-radius:999px; }
            .badge-hidden { background:#6b7280; color:#fff; padding:6px 10px; border-radius:999px; }

            .reply-input { max-width:520px; display:inline-block; }

            
    </style>
</head>

<body>

    <div class="browse-page-wrapper">

        <!-- Sidebar -->
        <aside class="sidebar">
            <a href="/" class="sidebar-brand">PixelUI<span class="Text_Admin">Admin</span></a>
             <ul class="nav-menu">

        @* SuperAdmin เท่านั้น *@
        @if (role == "SuperAdmin")
        {
            <li><i class="bi bi-person"></i><a href="/Admin/Userlist">User Management</a></li>
            <li><i class="bi bi-sliders"></i><a href="/Admin/ManageStaffRoles">Manage Roles</a></li>
            <li><i class="bi bi-wallet2"></i><a href="/Admin/FinancialOverview">Financial Overview</a></li>
        }

        @* Product Manager + SuperAdmin *@
        @if (role == "SuperAdmin" || role == "Product Manager")
        {
            <li><i class="bi bi-plus-circle"></i><a href="/Admin/CreateProduct">Add Product</a></li>
            <li><i class="bi bi-boxes"></i><a href="/Admin/ManageProducts">Manage Products</a></li>
            <li><i class="bi bi-check-circle"></i><a href="/Admin/QCApprove">QC & Approve</a></li>
        }

        @* Marketing + SuperAdmin *@
        @if (role == "SuperAdmin" || role == "Marketing")
        {
            <li><i class="bi bi-graph-up"></i><a href="/Admin/Analytics">Analytics</a></li>
            <li><i class="bi bi-tag"></i><a href="/Admin/ManagePromotions">Promotions</a></li>
        }

        @* Customer Support + SuperAdmin *@
        @if (role == "SuperAdmin" || role == "Customer Support")
        {
            <li class="active"><i class="bi bi-ticket"></i><a href="/Admin/Tickets">Support Tickets</a></li>
            <li><i class="bi bi-check-circle"></i><a href="/Admin/StudentVerification">Student Verify</a></li>
        }

    </ul>
            </aside>

            <main class="main-content">

                <div class="admin-header">
                        <div class="header-content" style="display:flex; justify-content:space-between; align-items:center;">
                            <div>
                                <h1><i class="bi bi-ticket"></i>Support Tickets</h1>
                                <p>Respond to user issues</p>
                            </div>
                            <div></div>
                        </div>
                    
                </div>

                <div class="products-table-container">
                    @if (Model != null && Model.Any())
                    {
                        <div class="tickets-card">
                            <div class="tickets-toolbar">
                                <input type="search" id="ticketSearch" class="tickets-search" placeholder="Search by user, subject or message..." />

                                <select id="statusFilter" class="tickets-search">
                                    <option value="">All statuses</option>
                                    <option value="Pending">Pending</option>
                                    <option value="Resolved">Resolved</option>
                                    <option value="Hidden">Hidden</option>
                                </select>

                                <div style="margin-left:auto; display:flex; gap:8px; align-items:center;">
                                    <small class="text-muted">Total: <strong>@Model.Count()</strong></small>
                                </div>
                            </div>

                            <table class="products-table" id="ticketsTable">
                                <thead>
                                    <tr>
                                        <th>Product</th>
                                        <th>User</th>
                                        <th>Subject</th>
                                        <th>Message</th>
                                        <th>Created</th>
                                        <th>Status</th>
                                        
                                        <th>Actions</th>
                                        <th>Assigned</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var t in Model)
                                    {
                                        <tr data-ticket-id="@t.TicketId" data-status="@t.Status" data-user="@(t.User?.Username ?? "Guest")" data-subject="@t.Subject" data-message="@t.Message">
                                            <td>@(t.Product != null ? t.Product.ProductName : "-")</td>
                                            <td>
                                                <div>@(t.User?.Username ?? "Guest")</div>
                                                <small style="color: white;">@t.User?.Email</small>
                                            </td>
                                           <td>
    <a href="/Admin/TicketDetail/@t.TicketId" style="color:#7dd3fc;">
        @t.Subject
    </a>
</td>
                                                @{ 
                                                    var displayMsg = t.Message ?? string.Empty;
                                                    if (displayMsg.StartsWith("[Product]"))
                                                    {
                                                        var idx = displayMsg.IndexOf("\n\n");
                                                        if (idx >= 0) displayMsg = displayMsg.Substring(idx + 2).Trim();
                                                        else
                                                        {
                                                            var idx2 = displayMsg.IndexOf('\n');
                                                            if (idx2 >= 0) displayMsg = displayMsg.Substring(idx2 + 1).Trim();
                                                        }
                                                    }
                                                }
                                                <td class="message-cell">@displayMsg</td>
                                            <td>@t.CreatedAt.ToString("g")</td>
                                            <td>
                                                @if (string.Equals(t.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="badge-pending">Pending</span>
                                                }
                                                else if (string.Equals(t.Status, "Resolved", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="badge-resolved">Resolved</span>
                                                }
                                                else if (string.Equals(t.Status, "Hidden", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="badge-hidden">Hidden</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-hidden">@t.Status</span>
                                                }
                                            </td>

                                            <td>
                                                <form method="post" action="/Admin/HideTicket/@t.TicketId" onsubmit="return confirm('Are you sure to remove this ticket?');">
                                                    @Html.AntiForgeryToken()
                                                    <button class="btn btn-danger btn-sm">
                                                        <i class="bi bi-trash"></i> Remove
                                                    </button>
                                                </form>
                                            </td>

                                           <td>
    @if (t.AssignedToUser != null)
    {
        <div class="fw-bold text-info">@t.AssignedToUser.Username</div>
    }
    else
    {
        <form method="post" onsubmit="event.preventDefault(); assignToMeForm(this, @t.TicketId)">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-warning btn-sm w-100">
                <i class="bi bi-person-plus"></i> Assign to me
            </button>
        </form>
    }
</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div style="text-align: center; padding: 60px; color: #aaa;">
                            <i class="bi bi-inbox" style="font-size: 60px; margin-bottom: 20px; display: block;"></i>

                            <h4>No support tickets</h4>
                            
                            <p>You're all caught up! No users have reported any issues.</p>
                        </div>
                    }

                </div>
            </main>

        </div>

    </body>

    <script>
        async function assignToMeForm(form, id) {
            try {
                const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenInput ? tokenInput.value : null;

                const fd = new FormData();
                if (token) fd.append('__RequestVerificationToken', token);

                const resp = await fetch('/Admin/AssignToMe/' + id, {
                    method: 'POST',
                    body: fd,
                    credentials: 'same-origin'
                });

                if (resp.ok) {
                    // go to ticket detail page after successful assign
                    window.location.href = '/Admin/TicketDetail/' + id;
                } else {
                    alert('Failed to assign ticket.');
                }
            } catch (err) {
                console.error(err);
                alert('Error assigning ticket.');
            }
        }
    </script>

    <script>
        // Simple row selection highlight (History removed)
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('#ticketsTable tbody tr').forEach(row => {
                row.addEventListener('click', function (e) {
                    if (e.target.closest('button') || e.target.closest('form')) return;
                    document.querySelectorAll('#ticketsTable tbody tr').forEach(r => r.classList.remove('selected'));
                    row.classList.add('selected');
                });
            });
        });
    </script>

        <!-- History feature removed -->

</html>