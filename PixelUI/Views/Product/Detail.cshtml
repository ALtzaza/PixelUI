<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-jsx.min.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/toolbar/prism-toolbar.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/copy-to-clipboard/prism-copy-to-clipboard.min.js"></script>


<script>
function exportCode(framework) {
    const htmlCode = document.getElementById('html-raw').value;
    const cssCode = document.getElementById('css-raw').value;

    if (document.getElementById('html-raw').disabled) {
        alert("Please purchase to export code.");
        return;
    }

    fetch('/Product/Export', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
            html: htmlCode,
            css: cssCode,
            framework: framework
        })
    })
    .then(res => res.text())
    .then(generatedCode => {
        // 1. กำหนดหัวข้อและ Icon ตาม framework
       // ของใหม่ที่ใช้เปลี่ยนรูปภาพโลโก้
const titleMap = { 'react': 'React', 'vue': 'Vue', 'svelte': 'Svelte', 'lit': 'Lit' };

// 1. สร้าง Map เก็บ Path ไปยังไฟล์โลโก้จริงที่คุณเอาไปใส่ไว้ใน wwwroot/images/
// สมมติว่าตั้งชื่อไฟล์ตามนี้ครับ ปรับเปลี่ยนให้ตรงกับชื่อไฟล์จริงของคุณนะ
const logoPathMap = { 
    'react': '/images/React.svg', 
    'vue': '/images/Vue.js.svg', 
    'svelte': '/images/Svelte.svg', 
    'lit': '/images/lit-1.svg' 
};

// 2. เปลี่ยนข้อความหัวข้อ
document.getElementById('exportTitle').innerText = titleMap[framework] || framework;

// 3. หา Element รูปภาพ และสั่งเปลี่ยน src ให้ตรงกับ framework ที่เลือก
const logoImgElement = document.getElementById('exportLogoImg');
if (logoImgElement) {
    // ถ้าหา path ใน map ไม่เจอ ให้ใช้ path ว่างเปล่า (หรือกำหนดรูป default ไว้ก็ได้ครับ)
    logoImgElement.src = logoPathMap[framework] || ''; 
}
        


        // 2. ใส่โค้ดดิบๆ ลงใน Code Block
        const codeElement = document.getElementById('exportCodeContent');
        codeElement.textContent = generatedCode;

        // 3. กำหนดภาษาเพื่อให้ Prism highlight ได้ถูกต้อง (สำหรับ React ใช้ JSX/JS)
        if (framework === 'react') {
            codeElement.className = 'language-jsx';
        } else {
            codeElement.className = 'language-javascript';
        }

        // 4. สั่งเปิด Modal ก่อน
        var myModal = new bootstrap.Modal(document.getElementById('exportModal'));
        myModal.show();

        // 5. หลังจาก Modal เปิดแล้ว ให้ Prism ปรับสีโค้ดใหม่ทั้งหมดในหน้านั้น
        // (เราใช้ setTimeout นิดหน่อยเพื่อให้ Modal โหลดเสร็จก่อน Prism จะคำนวณพื้นที่)
        setTimeout(() => {
            if (typeof Prism !== 'undefined') {
                Prism.highlightAll();
            }
        }, 100);
    })
    .catch(err => console.error("Export error:", err));
}

    function openTab(evt, sectionId) {
        var content = document.getElementsByClassName("tab-content");
        for (var i = 0; i < content.length; i++) content[i].classList.remove("show");

        var btns = document.getElementsByClassName("tab-btn");
        for (var i = 0; i < btns.length; i++) btns[i].classList.remove("active");

        document.getElementById(sectionId).classList.add("show");
        evt.currentTarget.classList.add("active");
    }

    function copyActiveCode() {
        const htmlSection = document.getElementById('html-section').classList.contains('show');
        const cssSection = document.getElementById('css-section').classList.contains('show');
        
        let targetId, targetLabel;
        if (htmlSection) {
            targetId = 'html-raw';
            targetLabel = '';
        } else if (cssSection) {
            targetId = 'css-raw';
            targetLabel = '';
        } else {
            alert('Please select HTML or CSS tab to copy code');
            return;
        }

        const codeElement = document.getElementById(targetId);
        if (codeElement.disabled) {
            alert('Sign in or purchase to access code');
            return;
        }

        const code = codeElement.value;
        navigator.clipboard.writeText(code).then(() => {
            const btn = document.getElementById('copyBtn');
            const original = btn.innerHTML;
            btn.innerHTML = '<i class="bi bi-check-lg text-success"></i> Copied ' + targetLabel + '!';
            setTimeout(() => { btn.innerHTML = original; }, 2000);
        });
    }

function updatePreview() {
    const htmlCode = document.getElementById('html-raw').value;
    const cssCode = document.getElementById('css-raw').value;
    const previewId = 'preview-@Model.Product.ProductId';
    const previewContainer = document.getElementById(previewId);

    if (previewContainer) {
        previewContainer.innerHTML = htmlCode;
    }

    // ใช้ style เดิม ไม่ต้องสร้างใหม่
    const styleElement = document.getElementById('dynamic-css');
    styleElement.innerHTML = cssCode;
}

    // Update preview when code is edited (only if user has purchased)
    const htmlEditor = document.getElementById('html-raw');
    const cssEditor = document.getElementById('css-raw');
    
    if (htmlEditor && !htmlEditor.disabled) {
        htmlEditor.addEventListener('input', updatePreview);
    }
    if (cssEditor && !cssEditor.disabled) {
        cssEditor.addEventListener('input', updatePreview);
    }

    function purchaseProduct(productId) {
        // Redirect to checkout or purchase page
        window.location.href = '@Url.Action("CheckOut", "Home")' + '?productId=' + productId;
    }

    function addToCart(productId) {
        alert('Product added to cart!');
        // Implement cart functionality
    }

function downloadFiles(productId) {
    // แก้จุดนี้: ใส่ @Url.Action เพื่อให้มัน Generate URL ที่ถูกต้องของ Server ออกมา
    const downloadUrl = '@Url.Action("Download", "Product")' + '?id=' + productId;
    
    const link = document.createElement('a');
    link.href = downloadUrl;
    // ไม่ต้องระบุ link.download = true; เพราะฝั่ง Server (Controller) 
    // เป็นคนกำหนดชื่อไฟล์และประเภทไฟล์ส่งมาให้อยู่แล้วครับ
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
}

    function downloadCode(type) {
        const codeElement = type === 'html' ? document.getElementById('html-raw') : document.getElementById('css-raw');
        const fileName = type === 'html' ? 'index.html' : 'style.css';
        const content = codeElement.value;

        const element = document.createElement('a');
        element.setAttribute('href', 'data:text/plain;charset=utf-8,' + encodeURIComponent(content));
        element.setAttribute('download', fileName);
        element.style.display = 'none';
        document.body.appendChild(element);
        element.click();
        document.body.removeChild(element);
    }

    document.getElementById('modeSwitch').addEventListener('change', function() {
        document.getElementById('previewContainer').style.backgroundColor = this.checked ? '#fff' : '#1a1a1a';
    });

    document.querySelector("#ticketForm").addEventListener("submit", async function (e) {
    e.preventDefault();

    const form = e.target;

    const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form)
    });

    const result = await response.json();

    if (result.success) {
        alert(result.message); // ✅ ตรงนี้แหละ "ส่งสำเร็จ"
        form.reset(); // เคลียร์ฟอร์ม
    } else {
        alert(result.message);
    }
});
</script>