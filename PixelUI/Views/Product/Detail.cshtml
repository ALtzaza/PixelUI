                    </div>
                    <textarea class="code-editor blurred" id="css-raw" disabled>@Model.Product.CssCode</textarea>
                }
                else if (!Model.IsPurchased && Model.IsLoggedIn)
                {
                    <div class="blurred-code-alert">
