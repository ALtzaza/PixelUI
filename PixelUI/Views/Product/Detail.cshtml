<div class="product-detail-container">
    <div class="top-nav d-flex justify-content-between align-items-center mb-3">
        <a href="javascript:history.back()" class="go-back-link">
            <i class="bi bi-arrow-left"></i> Go back
        </a>
        <div style="display: flex; flex-direction: column; align-items: flex-end;">
            <div class="user-info"> 
                <img src="https://ui-avatars.com/api/?name=@Model.Product.Author&background=random" class="rounded-circle ms-1" style="width:30px;">
                <strong class="text-white ms-1" style="margin-right: 10px;">@(Model.Product.Author ?? "AqFox")</strong>

                    <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#reportModal">
                        <i class="bi bi-bug-fill"></i> Report Bug
                    </button>
            </div>
            <div class="component-views" style="margin-top: 8px; font-size: 0.85rem; color: #888; display: flex; align-items: center; gap: 6px;">
                <i class="bi bi-eye"></i>
                <span>@(Model.Product.ViewCount > 0 ? (Model.Product.ViewCount > 999 ? $"{Model.Product.ViewCount / 1000}K" : Model.Product.ViewCount.ToString()) : "0") views</span>
            </div>
        </div>
    </div>

    <!-- Product Info Section -->
    <div class="product-info-card mb-4">
        <div class="product-header">
            <div>
                <h1 class="product-name">@Model.Product.ProductName</h1>
                <p class="product-category">
                    <i class="bi bi-tag-fill"></i> @(Model.Product.Category ?? "UI Component")
                </p>
            </div>
            <div class="product-price">
                <span class="price-label">Price</span>
                @if (Model.Product.BasePrice == null || Model.Product.BasePrice == 0)
                {
                    <span class="price-value free-tag">
                        <i class="bi bi-check-circle-fill"></i> Free
                    </span>
                }
                else
                {
                    <span class="price-value">@Model.Product.BasePrice?.ToString("$0.00")</span>
                }
            </div>
        </div>

        <div class="product-specs">
            @if (!string.IsNullOrEmpty(Model.Product.TechStack))
            {
                <div class="spec-item">
                    <i class="bi bi-code-slash"></i>
                    <div>
                        <strong>Tech Stack</strong>
                        <p>@Model.Product.TechStack</p>
                    </div>
                </div>
            }
            
            @if (Model.Product.ComplexityTier.HasValue)
            {
                <div class="spec-item">
                    <i class="bi bi-bar-chart"></i>
                    <div>
                        <strong>Complexity</strong>
                        <div class="complexity-level">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span class="dot @(i <= Model.Product.ComplexityTier ? "filled" : "")"></span>
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="spec-item">
                <i class="bi bi-person-circle"></i>
                <div>
                    <strong>Designer</strong>
                    <p>@(Model.Product.Author ?? "Anonymous")</p>
                </div>
            </div>
        </div>
    </div>

    <div class="workspace">
        
        <div class="preview-side" id="previewContainer">
            <div class="preview-tools">
                <div class="form-check form-switch d-inline-block ms-2">
                    <input class="form-check-input" type="checkbox" id="modeSwitch">
                    <i class="bi bi-brightness-high ms-1 text-white"></i>
                </div>
            </div>
            
            <div id="@previewId" class="preview-content">
                @Html.Raw(Model.Product.HtmlCode)
            </div>
        </div>

        <div class="code-side">
            <div class="code-tabs">
                <div class="btn-group">
                    <button class="tab-btn active" onclick="openTab(event, 'html-section')">
                        <i class="bi bi-filetype-html text-danger"></i> HTML
                    </button>
                    <button class="tab-btn" onclick="openTab(event, 'css-section')">
                        <i class="bi bi-filetype-css text-primary"></i> CSS
                    </button>
                    <button class="tab-btn" onclick="openTab(event, 'compatibility-section')">
                        <i class="bi bi-shield-check text-success"></i> Browser Support
                    </button>
                </div>

