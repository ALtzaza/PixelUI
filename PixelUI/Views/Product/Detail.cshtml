                }
                else
                {
                    <textarea class="code-editor" id="css-raw" spellcheck="false">@Model.Product.CssCode</textarea>
                }
            </div>

            <!-- Browser Compatibility Section -->
            <div id="compatibility-section" class="tab-content">
                <div class="compatibility-container">
                    @if (Model.BrowserCompatibility != null && Model.BrowserCompatibility.Any())
                    {
                        @foreach (var browser in Model.BrowserCompatibility)
                        {
                            <div class="browser-badge">
                                @if (browser.BrowserName.ToLower() == "chrome")
                                {
                                    <i class="bi bi-browser-chrome text-info"></i>
                                }
                                else if (browser.BrowserName.ToLower() == "firefox")
                                {
                                    <i class="bi bi-browser-firefox text-warning"></i>
                                }
                                else if (browser.BrowserName.ToLower() == "safari")
                                {
                                    <i class="bi bi-browser-safari text-secondary"></i>
                                }
                                else if (browser.BrowserName.ToLower() == "edge")
                                {
                                    <i class="bi bi-browser-edge text-primary"></i>
                                }
                                <div>
                                    <span class="browser-name">@browser.BrowserName</span>
                                    <span class="browser-version">@browser.MinVersion</span>
                                </div>
                                @if (browser.IsSupported)
                                {
                                    <i class="bi bi-check-circle-fill text-success ms-auto"></i>
                                }
                                else
                                {
                                    <i class="bi bi-x-circle-fill text-danger ms-auto"></i>
