                }
                else if (!Model.IsPurchased && Model.IsLoggedIn)
                {
                    <div class="blurred-code-alert">
                        <i class="bi bi-lock-fill"></i>
                        <p>Purchase to unlock full code access</p>
                    </div>
                    <textarea class="code-editor blurred" id="html-raw" disabled>@Model.Product.HtmlCode</textarea>
                }
                else
                {
                    <textarea class="code-editor" id="html-raw">@Model.Product.HtmlCode</textarea>
                }
