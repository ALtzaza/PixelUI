@model IEnumerable<PixelUI.Models.Db.Order>

@{
    ViewData["Title"] = "My Downloads";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-10 mx-auto">
            <!-- Page Header -->
            <div style="margin-bottom: 40px;">
                <h1 style="color: #fff; font-weight: 700; margin-bottom: 10px;">
                    <i class="bi bi-cloud-download me-2" style="color: #7C3AED;"></i> My Downloads
                </h1>
                <p style="color: #a1a1aa; margin: 0;">Download your purchased components and access their source code
                </p>
            </div>

            <!-- Downloads Grid/List -->
            @if (Model.Any())
            {
                <div
                    style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; margin-bottom: 40px;">
                    @foreach (var order in Model)
                    {
                        <div class="admin-card p-4" style="transition: all 0.3s ease; cursor: pointer;"
                             onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 25px 50px rgba(124, 58, 237, 0.2)'"
                             onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 20px 40px rgba(0, 0, 0, 0.4)'">
                            
                            <!-- Product Icon -->
                            <div
                                style="background: rgba(124, 58, 237, 0.1); border-radius: 12px; padding: 20px; text-align: center; margin-bottom: 15px;">
                                <i class="bi bi-box" style="font-size: 2.5rem; color: #7C3AED;"></i>
                            </div>

                            <!-- Product Info -->
                            <h4
                                style="color: #fff; margin: 0 0 10px 0; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                @(order.Product?.ProductName ?? "Unknown Product")
                            </h4>

                            <p style="color: #a1a1aa; font-size: 0.85rem; margin: 8px 0;">
                                <i class="bi bi-calendar me-1"></i>
                                Purchased: <strong>@(order.PurchaseDate?.ToString("dd MMM yyyy") ?? "N/A")</strong>
                            </p>

                            <p style="color: #a1a1aa; font-size: 0.85rem; margin: 8px 0;">
                                <i class="bi bi-tag me-1"></i>
                                Category: <strong>@(order.Product?.Category ?? "General")</strong>
                            </p>

                            <p style="color: #7C3AED; font-size: 0.85rem; margin: 8px 0; font-weight: 600;">
                                <i class="bi bi-cash-coin me-1"></i>
                                Price: $@(order.FinalPrice?.ToString("F2") ?? "0.00")
                            </p>

                            <!-- Action Buttons -->
                            <div style="margin-top: 20px; display: flex; gap: 12px; flex-direction: column;">
                                <a href="@Url.Action("Detail", "Product", new { id = order.ProductId })"
                                       class="btn btn-view-details">
                                    <i class="bi bi-eye me-2"></i> View Details
                                </a>

                                <button type="button" class="btn btn-download-soon" disabled>
                                    <i class="bi bi-download me-2"></i> Download (Soon)
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <!-- Summary Stats -->
                <div class="admin-card p-4" style="margin-bottom: 30px;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 20px;">
                        <div>
                            <p style="color: #a1a1aa; font-size: 0.85rem; margin: 0 0 8px 0;">
                                <i class="bi bi-box-seam me-1"></i> Total Downloads
                            </p>
                            <h3 style="color: #7C3AED; margin: 0; font-weight: 700;">@Model.Count()</h3>
                        </div>
                        <div>
                            <p style="color: #a1a1aa; font-size: 0.85rem; margin: 0 0 8px 0;">
                                <i class="bi bi-folder me-1"></i> Categories
                            </p>
                            <h3 style="color: #fff; margin: 0; font-weight: 700;">
                                @(Model.Select(o => o.Product?.Category).Distinct().Count())
                            </h3>
                        </div>
                        <div>
                            <p style="color: #a1a1aa; font-size: 0.85rem; margin: 0 0 8px 0;">
                                <i class="bi bi-calendar2 me-1"></i> Latest Download
                            </p>
                            <h3 style="color: #fff; margin: 0; font-weight: 700; font-size: 0.9rem;">
                                @(Model.First()?.PurchaseDate?.ToString("dd MMM yyyy") ?? "N/A")
                            </h3>
                        </div>
                        <div>
                            <p style="color: #a1a1aa; font-size: 0.85rem; margin: 0 0 8px 0;">
                                <i class="bi bi-check-circle me-1"></i> Total Value
                            </p>
                            <h3 style="color: #7C3AED; margin: 0; font-weight: 700;">
                                $@(Model.Sum(o => o.FinalPrice ?? 0).ToString("F2"))
                            </h3>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- Empty State -->
                <div class="admin-card p-5" style="text-align: center; padding: 80px 20px;">
                    <i class="bi bi-cloud-slash"
                       style="font-size: 4rem; color: #7C3AED; display: block; margin-bottom: 20px;"></i>
                    <h3 style="color: #fff; margin-bottom: 10px;">No Downloads Available</h3>
                    <p style="color: #a1a1aa; margin-bottom: 20px;">Purchase components to start downloading and accessing
                        source code</p>
                        <a href="@Url.Action("Browse", "Product")" class="btn btn-dev">
                            <i class="bi bi-grid me-1"></i> Browse Components
                        </a>
                    </div>
                }

                <!-- Back Link -->
                <div style="margin-top: 30px;">
                    <a href="@Url.Action("Profile", "User")"
                           style="color: #7C3AED; text-decoration: none; display: flex; align-items: center; gap: 8px; transition: all 0.3s;">
                        <i class="bi bi-arrow-left"></i> Back to Profile
                    </a>
                </div>
            </div>
        </div>
    </div>

    <style>
        /* ปุ่ม View Details สีม่วงทึบตามภาพ */
        .btn-view-details {
            background: #7C3AED;
            color: white;
            border: none;
            padding: 10px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            transition: 0.3s;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-view-details:hover {
            background: #8B5CF6;
            box-shadow: 0 0 15px rgba(124, 58, 237, 0.4);
            color: white;
        }

        /* ปุ่ม Download (Soon) แบบในภาพตัวอย่าง */
        .btn-download-soon {
            background: rgba(255, 255, 255, 0.02);
            /* พื้นหลังจางมากๆ */
            border: 1px solid #1f1f23;
            /* ขอบสีเข้ม */
            color: #555;
            /* ตัวอักษรสีเทาเข้มเพราะยังกดไม่ได้ */
            padding: 10px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: not-allowed;
            transition: 0.3s;
        }

        /* สไตล์สำหรับการ์ดให้เหมือนรูปภาพ */
        .admin-card {
            background: #0a0a0b;
            border: 1px solid #1f1f23;
            border-radius: 20px;
            /* มนขึ้นตามภาพ */
            padding: 24px !important;
        }

        /* ส่วนของ Icon Product ให้ดู Modern */
        .product-icon-box {
            background: #111113;
            /* เข้มกว่าพื้นการ์ดเล็กน้อย */
            border: 1px solid #1f1f23;
            border-radius: 12px;
            padding: 30px;
            text-align: center;
            margin-bottom: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
        }
    </style>
