@model PixelUI.Models.Db.User

@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5">
    <div class="row">
        <!-- Profile Card -->
        <div class="col-lg-8 mx-auto">
            <div class="admin-card p-5" style="margin-bottom: 30px;">
                <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 30px;">
                    <!-- Avatar -->
                    <img src="https://ui-avatars.com/api/?name=@Model.Username&background=7C3AED&color=fff&rounded=true&size=120"
                         class="rounded-circle" style="width: 120px; height: 120px; border: 3px solid #7C3AED;"
                         alt="@Model.Username">
                    
                    <!-- Profile Info -->
                    <div style="flex: 1;">
                        <h2 style="color: #fff; margin: 0 0 10px 0; font-weight: 700;">@Model.Username</h2>
                        <p style="color: #7C3AED; margin: 5px 0; font-size: 0.9rem; font-weight: 600;">
                            <i class="bi bi-shield-check me-2"></i>@(Model.Role?.RoleName ?? "Member")
                        </p>
                        <p style="color: #a1a1aa; margin: 5px 0; font-size: 0.9rem;">
                            <i class="bi bi-envelope me-2"></i>@Model.Email
                        </p>
                    </div>
                </div>

                <hr style="border-color: #333; margin: 30px 0;">

                <!-- 🎓 Student Verification -->
<div style="margin: 30px 0;">
    <h4 style="color: #fff; margin-bottom: 20px; font-weight: 600;">
        <i class="bi bi-mortarboard me-2"></i> Student Verification
    </h4>

    @if(ViewBag.StudentStatus == null)
    {
        <a href="/User/SubmitStudentVerification" class="btn btn-dev">
            <i class="bi bi-patch-check"></i> Verify as Student
        </a>
    }
    else if(ViewBag.StudentStatus == "Pending")
    {
        <span class="badge bg-warning">Pending Verification</span>
    }
    else if(ViewBag.StudentStatus == "Approved")
    {
        <span class="badge bg-success">Student Verified</span>
    }
    else if(ViewBag.StudentStatus == "Rejected")
    {
        <span class="badge bg-danger">Verification Rejected</span>
        <br />
        <a href="/User/SubmitStudentVerification" class="btn btn-outline-light mt-2">
            Try Again
        </a>
    }
</div>

<hr style="border-color: #333; margin: 30px 0;">

                <!-- Profile Details -->
                <div style="margin: 30px 0;">
                    <h4 style="color: #fff; margin-bottom: 20px; font-weight: 600;">
                        <i class="bi bi-info-circle me-2"></i> Profile Information
                    </h4>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
                        <div
                            style="padding: 15px; background: rgba(124, 58, 237, 0.05); border: 1px solid #333; border-radius: 8px;">
                            <p style="color: #a1a1aa; font-size: 0.85rem; margin: 0 0 8px 0;">Username</p>
                            <p style="color: #fff; font-weight: 600; margin: 0; font-size: 1rem;">@Model.Username</p>
                        </div>
                        
                        <div
                            style="padding: 15px; background: rgba(124, 58, 237, 0.05); border: 1px solid #333; border-radius: 8px;">
                            <p style="color: #a1a1aa; font-size: 0.85rem; margin: 0 0 8px 0;">Email Address</p>
                            <p style="color: #fff; font-weight: 600; margin: 0; font-size: 1rem;">@Model.Email</p>
                        </div>
                        
                        <div
                            style="padding: 15px; background: rgba(124, 58, 237, 0.05); border: 1px solid #333; border-radius: 8px;">
                            <p style="color: #a1a1aa; font-size: 0.85rem; margin: 0 0 8px 0;">Account Role</p>
                            <p style="color: #7C3AED; font-weight: 600; margin: 0; font-size: 1rem;">
                                @(Model.Role?.RoleName ?? "Member")
                            </p>
                        </div>
                        
                        <div
                            style="padding: 15px; background: rgba(124, 58, 237, 0.05); border: 1px solid #333; border-radius: 8px;">
                            <p style="color: #a1a1aa; font-size: 0.85rem; margin: 0 0 8px 0;">Member Since</p>
                            <p style="color: #fff; font-weight: 600; margin: 0; font-size: 1rem;">-</p>
                        </div>
                    </div>
                </div>

                <hr style="border-color: #333; margin: 30px 0;">

                <!-- Action Buttons -->
                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                    <a href="@Url.Action("MyPurchases", "User")" class="btn btn-dev" style="gap: 8px;">
                        <i class="bi bi-bag-check"></i> View Purchases
                    </a>
                    <a href="@Url.Action("Downloads", "User")" class="btn btn-outline-light">
                        <i class="bi bi-download me-1"></i> View Downloads
                    </a>
                    
                </div>
                <hr style="border-color: #333; margin: 30px 0;">

                <!-- 🎟️ My Tickets -->
                <div style="margin-top: 20px;">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
                        <h4 style="color: #fff; font-weight: 600; margin:0;">
                            <i class="bi bi-chat-dots me-2"></i> My Support Tickets
                        </h4>
                    </div>

                    @if (ViewBag.Tickets != null && ((List<PixelUI.Models.Db.Ticket>)ViewBag.Tickets).Any())
                    {
                        <div style="display: flex; flex-direction: column; gap: 15px;">
                            @foreach (var t in (List<PixelUI.Models.Db.Ticket>)ViewBag.Tickets)
                            {
                                <div
                                    style="padding: 15px; border: 1px solid #333; border-radius: 10px; background: rgba(255,255,255,0.03);">

                                    <div style="display:flex; justify-content:space-between; align-items:center;">
                                        <strong style="color:#fff;">@t.Subject</strong>

                                        <span style="
                                            font-size: 0.75rem;
                                            padding: 4px 10px;
                                            border-radius: 999px;
                                            @(t.Status == "Resolved"
                                                                                                                                                                          ? "background:rgba(16,185,129,0.2); color:#10b981;"
                                                                                                                                                                          : "background:rgba(255,193,7,0.2); color:#ffc107;")
                                            ">
                                            @t.Status
                                        </span>
                                    </div>

                                    <p style="color:#aaa; margin:10px 0;">@t.Message</p>

                                    <div style="margin-top:10px; padding:10px; border-left:3px solid #7C3AED;">
                                        @{
                                            var lastAdminReply = t.Messages?
                                                .Where(m => m.IsAdmin)
                                                .OrderByDescending(m => m.CreatedAt)
                                                .FirstOrDefault();
                                        }

                                        @if (lastAdminReply != null)
                                        {
                                            <span style="color:#ffffff;">
                                                <i class="bi bi-reply"></i> @lastAdminReply.Message
                                            </span>
                                            @if (!string.IsNullOrEmpty(lastAdminReply.AttachmentPath))
                                            {
                                                <div style="margin-top:8px;">
                                                    <a href="@lastAdminReply.AttachmentPath" target="_blank" rel="noopener noreferrer">
                                                        <img src="@lastAdminReply.AttachmentPath" style="max-width:200px; border-radius:8px;" alt="attachment"/>
                                                    </a>
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span style="color:#666;">Waiting for admin reply...</span>
                                        }
                                    </div>

                                    <div style="margin-top:12px;">
                                        @if (!string.Equals(t.Status, "Closed", StringComparison.OrdinalIgnoreCase) && !string.Equals(t.Status, "Resolved", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <form method="post" asp-controller="User" asp-action="ReplyTicket" enctype="multipart/form-data">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="ticketId" value="@t.TicketId" />
                                                <div class="d-flex reply-area" style="gap:12px; align-items:flex-end; margin-top:8px;">
                                                    <textarea name="message" class="form-control reply-textarea" placeholder="Write a reply to support..." rows="3" required></textarea>

                                                    <div style="display:flex; flex-direction:column; gap:8px; align-items:flex-end; width:180px;">
                                                        <label class="btn attach-btn btn-sm" for="attachment-@t.TicketId"><i class="bi bi-paperclip"></i> Attach</label>
                                                        <button type="submit" class="btn btn-primary btn-sm w-100">Send</button>
                                                        <input type="file" id="attachment-@t.TicketId" name="attachment" accept="image/*" style="display:none" data-filename="#attachmentFilename-@t.TicketId" data-preview="#attachmentPreview-@t.TicketId" />
                                                        <div id="attachmentFilename-@t.TicketId" class="attachment-filename text-muted small" style="max-width:160px; word-break:break-all;"></div>
                                                        <img id="attachmentPreview-@t.TicketId" class="attachment-preview" src="" style="display:none; margin-top:6px;" />
                                                    </div>
                                                </div>
                                            </form>
                                        }
                                        else
                                        {
                                            <div class="text-muted" style="font-size:0.9rem; margin-top:8px;">This ticket is closed or resolved and cannot be replied to.</div>
                                        }
                                    </div>

                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p style="color:#666;">You haven't submitted any tickets yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .btn-dev {
        background: var(--accent-purple);
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 6px;
        font-size: 0.85rem;
        font-weight: 600;
        transition: 0.3s;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    .btn-dev:hover {
        background: #8B5CF6;
        box-shadow: 0 0 15px rgba(124, 58, 237, 0.3);
        color: white;
    }

    .btn-outline-light {
        border-color: #a1a1aa;
        color: #a1a1aa;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 8px 16px;
        transition: all 0.3s ease;
        text-decoration: none;
        border: 1px solid;
        border-radius: 6px;
        display: inline-flex;
        align-items: center;
    }

    .btn-outline-light:hover {
        background-color: rgba(124, 58, 237, 0.1);
        border-color: white;
        color: white;
        box-shadow: 0 0 10px rgba(124, 58, 237, 0.3);
    }

    .admin-card {
        background: #0a0a0b;
        border: 1px solid #1f1f23;
        border-radius: 16px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
    }

    /* Reply area styles matching admin view */
    .reply-area { width:100%; gap:12px; }
    .reply-textarea { background:#0b0b0c; color:#ddd; border:1px solid #222; border-radius:8px; padding:12px; resize:vertical; }
    .attach-btn { background:transparent; color:#ddd; border:1px solid #2b2b2b; padding:6px 10px; border-radius:8px; cursor:pointer; }
    .attach-btn:hover { background:rgba(255,255,255,0.02); }
    .attachment-filename { opacity:0.9; }
    .attachment-preview { max-width:120px; border-radius:8px; margin-top:6px; box-shadow:0 6px 18px rgba(0,0,0,0.6); }
</style>

<script>
    // Attach handlers for all attachment inputs in the ticket list
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('input[type="file"][name="attachment"]').forEach(function (el) {
            el.addEventListener('change', function (e) {
                const f = el.files && el.files[0];
                const fnSel = el.dataset.filename;
                const pvSel = el.dataset.preview;
                const fnEl = fnSel ? document.querySelector(fnSel) : null;
                const pvEl = pvSel ? document.querySelector(pvSel) : null;
                if (!f) {
                    if (fnEl) fnEl.textContent = '';
                    if (pvEl) { pvEl.style.display = 'none'; pvEl.src = ''; }
                    return;
                }
                if (fnEl) fnEl.textContent = f.name;
                if (pvEl && f.type.startsWith('image/')) {
                    pvEl.src = URL.createObjectURL(f);
                    pvEl.style.display = 'block';
                } else if (pvEl) {
                    pvEl.style.display = 'none';
                }
            });
        });
    });
</script>
