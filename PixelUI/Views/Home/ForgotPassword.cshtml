@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/auth.css" />

<div class="auth-container">
    <div class="auth-box">

        <div class="auth-header">
            <h1>Forgot Password</h1>
            <p>Enter your email to receive a reset link</p>
        </div>


        @if (ViewBag.Message != null)
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i>
                @ViewBag.Message
            </div>
        }

        @if (ViewBag.ResetLink != null)
        {
            <div class="alert alert-info" style="flex-direction: column; align-items: flex-start;">
                <div style="margin-bottom: 10px;">
                    <i class="bi bi-link-45deg"></i>
                    <strong>Reset Password Link</strong>
                </div>

                <a href="@ViewBag.ResetLink" class="btn btn-outline-secondary" style="width:auto;">
                    Go to Reset Password
                </a>

                <small class="form-text mt-2">
                    This link will expire in 30 minutes
                </small>
            </div>
        }


        <form method="post" class="auth-form">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label for="Email" class="form-label">
                    <i class="bi bi-envelope" style="color: #7C3AED;"></i> Email Address
                </label>

                <input type="email" id="Email" name="Email" class="form-control" placeholder="you@example.com" required
                       value="@Model?.Email" />

                <span class="text-danger">
                    @Html.ValidationMessage("Email")
                </span>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="text-danger mb-3">
                    @Html.ValidationSummary(false, "")
                </div>
            }

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-send"></i> Send Reset Link
            </button>
        </form>

        <div class="auth-divider">
            <span>Remember your password?</span>
        </div>

        <a href="@Url.Action("Login", "Home")" class="btn btn-outline-secondary">
            <i class="bi bi-box-arrow-in-right"></i> Back to Login
        </a>

        <div class="auth-footer">
            <a href="@Url.Action("Register", "Home")">Create account</a>
            <span>•</span>
            <a href="@Url.Action("Index", "Home")">Back to Home</a>
        </div>
    </div>

    <div class="auth-side">
        <div class="auth-side-content">
            <h2>Password Recovery</h2>
            <p>We’ll send you a secure link to reset your password safely.</p>
            <ul>
                <li><i class="bi bi-shield-lock-fill"></i> Secure Reset Link</li>
                <li><i class="bi bi-clock-history"></i> Expire in 30 Minutes</li>
                <li><i class="bi bi-envelope-check"></i> Email Verification</li>
            </ul>
        </div>
    </div>
</div>