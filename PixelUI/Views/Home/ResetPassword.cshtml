@model ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/auth.css" />

<div class="auth-container">
    <div class="auth-box">

        <div class="auth-header">
            <h1>Reset Password</h1>
            <p>Create a new secure password for your account</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="text-danger mb-3">
                @Html.ValidationSummary(false, "")
            </div>
        }

        <form method="post" class="auth-form">
            @Html.AntiForgeryToken()

            <input type="hidden" name="Token" value="@Model.Token" />
            <input type="hidden" name="Email" value="@Model.Email" />

            <div class="form-group">
                <label class="form-label">
                    <i class="bi bi-lock" style="color: #7C3AED;"></i> New Password
                </label>
                <input type="password" name="NewPassword"
                       class="form-control"
                       placeholder="Enter new password"
                       required />
            </div>

            <div class="form-group">
                <label class="form-label">
                    <i class="bi bi-shield-lock" style="color: #7C3AED;"></i> Confirm Password
                </label>
                <input type="password" name="ConfirmPassword"
                       class="form-control"
                       placeholder="Confirm password"
                       required />
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle"></i> Reset Password
            </button>
        </form>

        <div class="auth-divider">
            <span>Remember your password?</span>
        </div>

        <a href="@Url.Action("Login", "Home")" class="btn btn-outline-secondary">
            <i class="bi bi-box-arrow-in-right"></i> Back to Login
        </a>

    </div>

    <div class="auth-side">
        <div class="auth-side-content">
            <h2>Security Matters</h2>
            <p>Choose a strong password to keep your account safe.</p>
            <ul>
                <li><i class="bi bi-check-circle-fill"></i> At least 8 characters</li>
                <li><i class="bi bi-check-circle-fill"></i> Use letters & numbers</li>
                <li><i class="bi bi-check-circle-fill"></i> Avoid common passwords</li>
            </ul>
        </div>
    </div>
</div>