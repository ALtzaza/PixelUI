@model PixelUI.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<link rel="stylesheet" href="~/css/auth.css" />

<style>
    .checkout-container {
        background-color: #000;
        min-height: 100vh;
        padding: 40px 20px;
    }

    .checkout-wrapper {
        max-width: 1000px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 30px;
    }

    .checkout-form {
        background: linear-gradient(135deg, #1a1a1a 0%, #0d0d0d 100%);
        border: 1px solid #333;
        border-radius: 12px;
        padding: 30px;
    }

    .order-summary {
        background: linear-gradient(135deg, #1a1a1a 0%, #0d0d0d 100%);
        border: 1px solid #333;
        border-radius: 12px;
        padding: 30px;
        height: fit-content;
        position: sticky;
        top: 20px;
    }

    .form-section {
        margin-bottom: 25px;
    }

    .form-section h3 {
        font-size: 16px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 15px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #ccc;
        font-size: 13px;
        font-weight: 600;
    }

    .form-group input,
    .form-group select {
        width: 100%;
        padding: 12px;
        background-color: #0d0d0d;
        border: 1px solid #333;
        border-radius: 6px;
        color: #fff;
        font-size: 14px;
        transition: all 0.3s;
    }

    .form-group input:focus,
    .form-group select:focus {
        outline: none;
        border-color: #4387f4;
        box-shadow: 0 0 10px rgba(67, 135, 244, 0.2);
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .form-row.three {
        grid-template-columns: repeat(3, 1fr);
    }

    /* Order Summary */
    .summary-title {
        font-size: 18px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 20px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .product-info {
        padding-bottom: 20px;
        border-bottom: 1px solid #333;
        margin-bottom: 20px;
    }

    .product-name {
        font-size: 14px;
        color: #ccc;
        margin-bottom: 5px;
    }

    .product-price {
        font-size: 24px;
        font-weight: 700;
        color: #4387f4;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        font-size: 13px;
        color: #ccc;
        border-bottom: 1px solid #222;
    }

    .summary-row.total {
        padding: 15px 0;
        font-size: 16px;
        font-weight: 700;
        color: #fff;
        border-bottom: none;
    }

    .summary-row span.price {
        color: #4387f4;
        font-weight: 600;
    }

    .summary-row.total span.price {
        font-size: 20px;
    }

    .user-info-box {
        background-color: rgba(67, 135, 244, 0.1);
        border: 1px solid #4387f4;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        font-size: 13px;
    }

    .user-info-box .label {
        color: #888;
        margin-bottom: 3px;
    }

    .user-info-box .value {
        color: #fff;
        font-weight: 600;
    }

    .license-options {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-bottom: 15px;
    }

    .license-option {
        position: relative;
    }

    .license-option input[type="radio"] {
        display: none;
    }

    .license-option label {
        display: block;
        padding: 12px;
        background-color: #0d0d0d;
        border: 2px solid #333;
        border-radius: 6px;
        cursor: pointer;
        text-align: center;
        font-weight: 600;
        transition: all 0.3s;
        margin: 0;
    }

    .license-option input[type="radio"]:checked + label {
        border-color: #4387f4;
        background-color: rgba(67, 135, 244, 0.1);
    }

    /* Buttons */
    .button-group {
        display: flex;
        gap: 10px;
        margin-top: 30px;
    }

    .btn-purchase {
        flex: 1;
        padding: 14px 20px;
        background: linear-gradient(135deg, #4387f4 0%, #2563eb 100%);
        border: none;
        border-radius: 8px;
        color: #fff;
        font-weight: 700;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-purchase:hover {
        box-shadow: 0 8px 20px rgba(67, 135, 244, 0.3);
        transform: translateY(-2px);
    }

    .btn-cancel {
        flex: 1;
        padding: 14px 20px;
        background-color: transparent;
        border: 2px solid #333;
        border-radius: 8px;
        color: #ccc;
        font-weight: 700;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-cancel:hover {
        border-color: #666;
        color: #fff;
    }

    .alert {
        padding: 15px;
        background-color: rgba(220, 38, 38, 0.1);
        border: 1px solid #dc2626;
        border-radius: 8px;
        color: #fca5a5;
        margin-bottom: 20px;
        font-size: 13px;
    }

    @@media (max-width: 768px) {
        .checkout-wrapper {
            grid-template-columns: 1fr;
        }

        .order-summary {
            position: static;
        }
    }
</style>

<div class="checkout-container">
    <div class="checkout-wrapper">
        <!-- Checkout Form -->
        <div>
            <form method="post" id="checkoutForm">
                @if (!string.IsNullOrEmpty(ViewBag.Message))
                {
                    <div class="alert">
                        <i class="bi bi-exclamation-triangle"></i>
                        @ViewBag.Message
                    </div>
                }

                <!-- User Information -->
                <div class="form-section">
                    <h3><i class="bi bi-person-circle"></i> Billing Information</h3>
                    <div class="user-info-box">
                        <div class="label">User Name</div>
                        <div class="value">@Model.UserName</div>
                    </div>
                    <div class="user-info-box">
                        <div class="label">Email</div>
                        <div class="value">@Model.UserEmail</div>
                    </div>
                </div>

                <!-- License Type -->
                <div class="form-section">
                    <h3><i class="bi bi-certificate"></i> License Type</h3>
                    <div class="license-options">
                        <div class="license-option">
                            <input type="radio" id="personal" name="LicenseType" value="Personal" checked>
                            <label for="personal">
                                <i class="bi bi-person"></i><br>
                                Personal
                            </label>
                        </div>
                        <div class="license-option">
                            <input type="radio" id="commercial" name="LicenseType" value="Commercial">
                            <label for="commercial">
                                <i class="bi bi-building"></i><br>
                                Commercial
                            </label>
                        </div>
                    </div>
                </div>

                <!-- Promo Code Section -->
                <div class="form-section">
                    <h3><i class="bi bi-tag"></i> Promo Code</h3>
                    <div class="form-group">
                        <label for="promoCode">Have a discount code?</label>
                        <div style="display: flex; gap: 10px;">
                            <input type="text" id="promoCode" name="PromoCode" placeholder="Enter promo code" style="flex: 1;" value="@(ViewBag.InitialPromoCode ?? "")">
                            <button type="button" id="applyPromo" class="btn-apply-promo" style="padding: 12px 24px; background: #4387f4; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: 600; white-space: nowrap;">Apply</button>
                        </div>
                    </div>
                    <div id="promoMessage" style="margin-top: 10px; padding: 10px; border-radius: 6px; display: none; font-size: 13px;"></div>
                </div>

                <!-- Payment Information -->
                <div class="form-section">
                    <h3><i class="bi bi-credit-card"></i> Payment Details</h3>

                    <div class="form-group">
                        <label for="cardName">Cardholder Name</label>
                        <input type="text" id="cardName" name="CardName" placeholder="Full Name" required>
                    </div>

                    <div class="form-group">
                        <label for="cardNumber">Card Number</label>
                        <input type="text" id="cardNumber" name="CardNumber" placeholder="1234 5678 9012 3456" maxlength="19" required pattern="[0-9\s]{13,19}">
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="expiryMonth">Month</label>
                            <select id="expiryMonth" name="ExpiryMonth" required>
                                <option value="">Select Month</option>
                                @for (int i = 1; i <= 12; i++)
                                {
                                    <option value="@i.ToString("D2")">@i.ToString("D2")</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="expiryYear">Year</label>
                            <select id="expiryYear" name="ExpiryYear" required>
                                <option value="">Select Year</option>
                                @for (int i = DateTime.Now.Year; i <= DateTime.Now.Year + 10; i++)
                                {
                                    <option value="@i.ToString("D2")">@i</option>
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="cvv">CVV</label>
                            <input type="text" id="cvv" name="CVV" placeholder="123" maxlength="4" required pattern="[0-9]{3,4}">
                        </div>
                    </div>
                </div>

                <input type="hidden" name="ProductId" value="@Model.ProductId">
                <input type="hidden" name="UserId" value="@Model.UserId">
                <input type="hidden" name="BundleProductIds" value="@(Model.BundleProductIds ?? String.Empty)" />
                <input type="hidden" name="IsBundle" value="@(Model.IsBundle ? "true" : "false")" />
                @if (!string.IsNullOrEmpty(ViewBag.InitialPromoCode as string) && (ViewBag.InitialAppliedDiscount ?? 0) > 0)
                {
                    <input type="hidden" name="AppliedPromoCode" value="@(ViewBag.InitialPromoCode)" />
                    <input type="hidden" name="AppliedDiscount" value="@(ViewBag.InitialAppliedDiscount)" />
                }

                <div class="button-group">
                    <button type="submit" class="btn-purchase">
                        <i class="bi bi-check-circle"></i> Complete Purchase
                    </button>
                    <a href="javascript:history.back()" class="btn-cancel">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                </div>
            </form>
        </div>

        <!-- Order Summary -->
        <div>
            <div class="order-summary">
                <div class="summary-title">
                    <i class="bi bi-receipt"></i> Order Summary
                </div>

                @if (ViewBag.IsBundle == true)
                {
                    <div class="product-info">
                        <div style="font-weight:700; margin-bottom:8px;">Bundle Contents</div>
                        <div style="display:flex; gap:12px; flex-wrap:wrap;">
                            @foreach (var p in (ViewBag.BundleProducts as List<PixelUI.Models.Db.Product> ?? new List<PixelUI.Models.Db.Product>()))
                            {
                                <div style="background:#070708; padding:8px; border-radius:8px; width:100%; max-width:260px; border:1px solid #222;">
                                    <div style="font-weight:700; font-size:0.95rem;">@p.ProductName</div>
                                    <div style="color:#888; font-size:0.85rem;">@p.Author</div>
                                    <div style="color:#4387f4; font-weight:700; margin-top:6px;">$@((p.BasePrice ?? 0).ToString("F2"))</div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="product-info">
                        <div class="product-name">@Model.ProductName</div>
                        <div class="product-price">$@Model.ProductPrice.ToString("F2")</div>
                    </div>
                }

                @{ 
                    var serverDiscount = Convert.ToDecimal(ViewBag.InitialAppliedDiscount ?? 0);
                    var subtotal = Model.ProductPrice;
                    var serverDiscountAmount = Math.Round(subtotal * (serverDiscount / 100m), 2);
                    var serverTotal = subtotal - serverDiscountAmount;
                    var serverStyle = serverDiscount > 0 ? "display:flex; color:#22c55e;" : "display:none;";
                }
                <div class="summary-row">
                    <span>Price</span>
                    <span class="price" id="subtotal">@("$" + subtotal.ToString("F2"))</span>
                </div>

                <div class="summary-row" id="discountRow" style="@serverStyle">
                    <span><i class="bi bi-tag"></i> Discount (@(serverDiscount)%)</span>
                    <span class="price" id="discountAmount" style="color: #22c55e;">@("-$" + serverDiscountAmount.ToString("F2"))</span>
                </div>

                <div class="summary-row total">
                    <span>Total Amount</span>
                    <span class="price" id="totalAmount">@("$" + serverTotal.ToString("F2"))</span>
                </div>

                <div style="margin-top: 20px; padding: 15px; background-color: rgba(34, 197, 94, 0.1); border: 1px solid #22c55e; border-radius: 8px; font-size: 12px; color: #86efac;">
                    <i class="bi bi-shield-check"></i>
                    Secure payment processing powered by Stripe
                </div>

                <div style="margin-top: 15px; padding: 15px; background-color: rgba(59, 130, 246, 0.1); border: 1px solid #3b82f6; border-radius: 8px; font-size: 12px; color: #93c5fd;">
                    <i class="bi bi-info-circle"></i>
                    Upon purchase, you will receive instant access to all code and files.
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const productPrice = @Model.ProductPrice;
    let appliedDiscount = @(ViewBag.InitialAppliedDiscount ?? 0);
    
    // ดึง promotions จากฐานข้อมูล ผ่าน ViewBag
    const availablePromos = @Html.Raw(ViewBag.AvailablePromos ?? "{}");

    // Format card number with spaces
    document.getElementById('cardNumber').addEventListener('input', function (e) {
        let value = e.target.value.replace(/\s/g, '');
        let formatted = value.match(/.{1,4}/g)?.join(' ') || value;
        e.target.value = formatted;
    });

    // Handle promo code apply
    document.getElementById('applyPromo').addEventListener('click', function () {
        const promoCode = document.getElementById('promoCode').value.trim();
        const promoMessage = document.getElementById('promoMessage');
        
        if (!promoCode) {
            promoMessage.textContent = 'Please enter a promo code';
            promoMessage.style.backgroundColor = 'rgba(220, 38, 38, 0.1)';
            promoMessage.style.color = '#fca5a5';
            promoMessage.style.border = '1px solid #dc2626';
            promoMessage.style.display = 'block';
            return;
        }

        // ตรวจสอบ promo code จากฐานข้อมูล (case-insensitive)
        const normalizedPromo = promoCode.toLowerCase();
        const foundPromo = Object.keys(availablePromos).find(key => key.toLowerCase() === normalizedPromo);
        
        if (foundPromo !== undefined) {
            const promoData = availablePromos[foundPromo];
            
            // เช็ค usage limit
            if (promoData.currentUsage >= promoData.maxUsage) {
                promoMessage.textContent = `✗ This promo code has reached its usage limit`;
                promoMessage.style.backgroundColor = 'rgba(220, 38, 38, 0.1)';
                promoMessage.style.color = '#fca5a5';
                promoMessage.style.border = '1px solid #dc2626';
                promoMessage.style.display = 'block';
                return;
            }
            
            appliedDiscount = promoData.discount;
            updateTotal();
            
            promoMessage.textContent = `✓ Promo code "${promoCode}" applied! You save ${appliedDiscount}%`;
            promoMessage.style.backgroundColor = 'rgba(34, 197, 94, 0.1)';
            promoMessage.style.color = '#86efac';
            promoMessage.style.border = '1px solid #22c55e';
            promoMessage.style.display = 'block';
            
            // Disable input after apply
            document.getElementById('promoCode').disabled = true;
            document.getElementById('applyPromo').disabled = true;
            document.getElementById('applyPromo').style.opacity = '0.5';
        } else {
            appliedDiscount = 0;
            updateTotal();
            
            promoMessage.textContent = '✗ Invalid promo code';
            promoMessage.style.backgroundColor = 'rgba(220, 38, 38, 0.1)';
            promoMessage.style.color = '#fca5a5';
            promoMessage.style.border = '1px solid #dc2626';
            promoMessage.style.display = 'block';
        }

        // Add promo code to form submission
        if (appliedDiscount > 0) {
            let promoInput = document.getElementById('appliedPromoCode');
            if (!promoInput) {
                promoInput = document.createElement('input');
                promoInput.type = 'hidden';
                promoInput.id = 'appliedPromoCode';
                promoInput.name = 'AppliedPromoCode';
                document.getElementById('checkoutForm').appendChild(promoInput);
            }
            promoInput.value = promoCode;
            
            let discountInput = document.getElementById('appliedDiscount');
            if (!discountInput) {
                discountInput = document.createElement('input');
                discountInput.type = 'hidden';
                discountInput.id = 'appliedDiscount';
                discountInput.name = 'AppliedDiscount';
                document.getElementById('checkoutForm').appendChild(discountInput);
            }
            discountInput.value = appliedDiscount;
        }
    });

    // If server provided an initial applied promo, ensure hidden inputs exist
    @if (!string.IsNullOrEmpty(ViewBag.InitialPromoCode as string) && (ViewBag.InitialAppliedDiscount ?? 0) > 0)
    {
        <text>
        (function ensureHiddenPromo() {
            var form = document.getElementById('checkoutForm');
            if (!document.getElementById('appliedPromoCode')) {
                var p = document.createElement('input'); p.type = 'hidden'; p.name = 'AppliedPromoCode'; p.id = 'appliedPromoCode'; p.value = '@(ViewBag.InitialPromoCode)'; form.appendChild(p);
            }
            if (!document.getElementById('appliedDiscount')) {
                var d = document.createElement('input'); d.type = 'hidden'; d.name = 'AppliedDiscount'; d.id = 'appliedDiscount'; d.value = '@(ViewBag.InitialAppliedDiscount)'; form.appendChild(d);
            }
        })();
        </text>
    }

    function updateTotal() {
        const subtotal = productPrice;
        const discountAmount = subtotal * (appliedDiscount / 100);
        const total = subtotal - discountAmount;

        document.getElementById('subtotal').textContent = '$' + subtotal.toFixed(2);
        document.getElementById('totalAmount').textContent = '$' + total.toFixed(2);
        
        // Show/hide discount row
        const discountRow = document.getElementById('discountRow');
        if (appliedDiscount > 0) {
            discountRow.style.display = 'flex';
            document.getElementById('discountAmount').textContent = '-$' + discountAmount.toFixed(2);
        } else {
            discountRow.style.display = 'none';
        }
    }

    // Validate form before submission
    document.getElementById('checkoutForm').addEventListener('submit', function (e) {
        const cardNumber = document.getElementById('cardNumber').value.replace(/\s/g, '');
        if (cardNumber.length < 13 || cardNumber.length > 19) {
            e.preventDefault();
            alert('Please enter a valid card number');
            return false;
        }
    });

    // If arriving from a bundle and server provided an initial promo code, auto-apply it
    @if (!string.IsNullOrEmpty(ViewBag.InitialPromoCode as string))
    {
        <text>
        document.addEventListener('DOMContentLoaded', function () {
            try {
                const initial = '@(ViewBag.InitialPromoCode)';
                document.getElementById('promoCode').value = initial;
                // small delay to ensure availablePromos variable is parsed
                setTimeout(function () { document.getElementById('applyPromo').click(); }, 250);
            } catch (e) { console.warn(e); }
        });
        </text>
    }

    // Ensure totals are calculated on load and show server-applied promo message
    document.addEventListener('DOMContentLoaded', function () {
        try {
            if (appliedDiscount > 0) {
                // show promo message
                var promoMessage = document.getElementById('promoMessage');
                promoMessage.textContent = '✓ Promo code "' + ('@(ViewBag.InitialPromoCode ?? "")') + '" applied! You save ' + appliedDiscount + '%';
                promoMessage.style.backgroundColor = 'rgba(34, 197, 94, 0.1)';
                promoMessage.style.color = '#86efac';
                promoMessage.style.border = '1px solid #22c55e';
                promoMessage.style.display = 'block';
                // disable inputs
                var pc = document.getElementById('promoCode'); if (pc) pc.disabled = true;
                var ap = document.getElementById('applyPromo'); if (ap) { ap.disabled = true; ap.style.opacity = '0.5'; }
            }
        } catch (e) { console.warn(e); }
        // update totals regardless
        try { updateTotal(); } catch (e) { console.warn(e); }
    });
</script>
