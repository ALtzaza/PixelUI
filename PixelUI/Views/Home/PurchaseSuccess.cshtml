@model PixelUI.Models.Db.Order

@{
    ViewData["Title"] = "Purchase Successful";
}

<style>
    .success-container {
        background-color: #000;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .success-card {
        background: linear-gradient(135deg, #1a1a1a 0%, #0d0d0d 100%);
        border: 1px solid #333;
        border-radius: 12px;
        padding: 50px;
        text-align: center;
        max-width: 500px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }

    .success-icon {
        font-size: 80px;
        color: #22c55e;
        margin-bottom: 20px;
        animation: bounce 0.6s ease-in-out;
    }

    @@keyframes bounce {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-10px); }
    }

    .success-title {
        font-size: 32px;
        font-weight: 700;
        color: #fff;
        margin-bottom: 10px;
    }

    .success-message {
        font-size: 16px;
        color: #ccc;
        margin-bottom: 30px;
    }

    .order-details {
        background-color: rgba(67, 135, 244, 0.1);
        border: 1px solid #4387f4;
        border-radius: 8px;
        padding: 20px;
        margin: 30px 0;
        text-align: left;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid #2d3748;
        font-size: 14px;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        color: #888;
        font-weight: 600;
    }

    .detail-value {
        color: #fff;
        font-weight: 600;
    }

    .button-group {
        display: flex;
        gap: 12px;
        margin-top: 30px;
        flex-direction: column;
    }

    .btn {
        padding: 14px 20px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 14px;
        text-decoration: none;
        display: inline-block;
        transition: all 0.3s;
        border: none;
        cursor: pointer;
    }

    .btn-primary {
        background: linear-gradient(135deg, #4387f4 0%, #2563eb 100%);
        color: #fff;
    }

    .btn-primary:hover {
        box-shadow: 0 8px 20px rgba(67, 135, 244, 0.3);
        transform: translateY(-2px);
    }

    .btn-secondary {
        background-color: transparent;
        border: 2px solid #4387f4;
        color: #4387f4;
    }

    .btn-secondary:hover {
        background-color: rgba(67, 135, 244, 0.1);
    }

    .alert-box {
        background-color: rgba(34, 197, 94, 0.1);
        border: 1px solid #22c55e;
        border-radius: 8px;
        padding: 15px;
        margin-top: 20px;
        font-size: 13px;
        color: #86efac;
    }

    .email-notice {
        background-color: rgba(59, 130, 246, 0.1);
        border: 1px solid #3b82f6;
        border-radius: 8px;
        padding: 15px;
        margin-top: 15px;
        font-size: 13px;
        color: #93c5fd;
    }

    .icon {
        margin-right: 8px;
    }
</style>

<div class="success-container">
    <div class="success-card">
        <div class="success-icon">
            <i class="bi bi-check-circle-fill"></i>
        </div>

        <div class="success-title">Purchase Complete!</div>
        <div class="success-message">
            Thank you for your purchase. Your access has been activated.
        </div>

        <div class="order-details">
            <div class="detail-row">
                <span class="detail-label">Order ID</span>
                <span class="detail-value">#@Model.OrderId</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Product</span>
                <span class="detail-value">@Model.Product?.ProductName</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Amount Paid</span>
                <span class="detail-value">$@Model.FinalPrice?.ToString("F2")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Purchase Date</span>
                <span class="detail-value">@Model.PurchaseDate?.ToString("MMM dd, yyyy HH:mm")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">License Type</span>
                <span class="detail-value">@(Model.LicenseType ?? "Personal")</span>
            </div>
        </div>

        <div class="alert-box">
            <i class="bi bi-shield-check icon"></i>
            Your license has been registered to your account
        </div>

        <div class="email-notice">
            <i class="bi bi-envelope icon"></i>
            A confirmation email has been sent to your registered email address
        </div>

        <div class="button-group">
            <a href="@Url.Action("Browse", "Product")" class="btn btn-primary">
                <i class="bi bi-arrow-right icon"></i> Browse More Products
            </a>
            <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">
                <i class="bi bi-house icon"></i> Back to Home
            </a>
        </div>
    </div>
</div>
