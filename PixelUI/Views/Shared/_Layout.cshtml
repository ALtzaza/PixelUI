<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PixelUI - Dev Edition</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            :root {
                --bg-body: #050505;
                --bg-nav: rgba(5, 5, 5, 0.85);
                --accent-purple: #7C3AED;
                /* ม่วงแนว Dev */
                --accent-glow: #7c3aed4d;
                --border-color: #1f1f23;
                --text-main: #f4f4f5;
                --text-muted: #a1a1aa;
            }

            body {
                background-color: var(--bg-body);
                color: var(--text-main);
                /* ให้ฟีลเขียนโค้ด */
                margin: 0;
                padding: 0;
            }

            /* ⚠️ Prevent auth.css from affecting navbar */
            header {
                font-family: 'Inter', sans-serif;
            }

            /* Navbar Style */
            .custom-navbar {
                background-color: var(--bg-nav);
                backdrop-filter: blur(12px);
                border-bottom: 1px solid var(--border-color);
                padding: 0.75rem 2rem;
            }

            .navbar-brand {
                color: white !important;
                font-weight: 800;
                letter-spacing: -1px;
                font-size: 1.5rem;
            }

            .navbar-brand span {
                color: var(--accent-purple);
                /* แต้มสีม่วงที่ชื่อ */
            }

            .nav-link {
                color: var(--text-muted) !important;
                font-size: 0.85rem;
                font-weight: 500;
                padding: 0 18px !important;
                transition: all 0.3s ease;
            }

            .nav-link:hover {
                color: var(--accent-purple) !important;
                text-shadow: 0 0 10px var(--accent-glow);
            }

            /* Search Container - VS Code Style */
            .search-container {
                background: #111113;
                border: 1px solid var(--border-color);
                border-radius: 6px;
                padding: 5px 12px;
                display: flex;
                align-items: center;
                min-width: 280px;
                transition: all 0.2s ease;
            }

            .search-container:focus-within {
                border-color: var(--accent-purple);
                box-shadow: 0 0 0 3px var(--accent-glow);
            }

            .search-input {
                background: transparent;
                border: none;
                color: white;
                font-size: 0.8rem;
                outline: none;
                width: 100%;
                margin-left: 10px;
            }

            /* Social Icons & Buttons */
            .social-icon {
                color: var(--text-muted);
                font-size: 1.1rem;
                margin: 0 8px;
                transition: 0.2s;
            }

            .social-icon:hover {
                color: var(--accent-purple);
            }

            .btn-dev {
                background: var(--accent-purple);
                color: white;
                border: none;
                padding: 6px 16px;
                border-radius: 6px;
                font-size: 0.85rem;
                font-weight: 600;
                transition: 0.3s;
            }

            .btn-dev:hover {
                background: #8B5CF6;
                box-shadow: 0 0 15px var(--accent-glow);
                color: white;
            }

            /* Auth Buttons Styling */
            .btn-outline-light {
                border-color: var(--text-muted);
                color: var(--text-muted);
                font-weight: 600;
                font-size: 0.85rem;
                padding: 6px 14px;
                transition: all 0.3s ease;
            }

            .btn-outline-light:hover {
                background-color: transparent;
                border-color: white;
                color: white;
                box-shadow: 0 0 10px rgba(120, 60, 237, 0.3);
            }

            .btn-dev.btn-sm {
                padding: 6px 14px;
                font-size: 0.85rem;
            }

            /* User Info Styling */
            .user-info-section {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 6px 12px;
                background: rgba(67, 135, 244, 0.08);
                border: 1px solid rgba(67, 135, 244, 0.2);
                border-radius: 8px;
            }

            .user-info-username {
                font-size: 0.85rem;
                color: var(--text-main);
                font-weight: 600;
                margin: 0;
            }

            .user-info-role {
                font-size: 0.75rem;
                color: var(--text-muted);
                margin: 0;
            }

            .user-divider {
                width: 1px;
                height: 18px;
                background: rgba(255, 255, 255, 0.1);
                margin: 0 8px;
            }

            .btn-logout {
                background: transparent;
                border: 1px solid #dc3545;
                color: #dc3545;
                padding: 5px 12px;
                font-size: 0.8rem;
                font-weight: 600;
                border-radius: 6px;
                transition: all 0.3s;
            }

            .btn-logout:hover {
                background: rgba(220, 53, 69, 0.1);
                border-color: #ff6b7a;
                color: #ff6b7a;
            }

            .hero-glow {
                position: absolute;
                top: 0;
                left: 50%;
                transform: translateX(-50%);
                width: 600px;
                height: 300px;
                background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
                z-index: -1;
                filter: blur(60px);
            }


            /* Admin Card Style */
            .admin-card {
                background: #0a0a0b;
                border: 1px solid #1f1f23;
                border-radius: 16px;
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
            }

            .icon-box {
                width: 48px;
                height: 48px;
                background: var(--accent-glow);
                color: var(--accent-purple);
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.5rem;
            }

            /* Custom Input Styling */
            .input-group-custom {
                position: relative;
                display: flex;
                align-items: center;
            }

            .input-group-custom i {
                position: absolute;
                left: 15px;
                color: var(--text-muted);
                font-size: 1rem;
            }

            .form-control-custom {
                width: 100%;
                background: #111113;
                border: 1px solid #1f1f23;
                border-radius: 8px;
                padding: 10px 15px 10px 45px;
                color: white;
                font-size: 0.9rem;
                transition: all 0.2s;
            }

            .form-control-custom:focus {
                border-color: var(--accent-purple);
                outline: none;
                background: #161618;
                box-shadow: 0 0 0 3px var(--accent-glow);
            }

            .select-custom {
                appearance: none;
                cursor: pointer;
            }


            /* การตั้งค่าพื้นฐานสำหรับ Footer */
            .main-footer {
                background-color: #000000;
                /* สีดำสนิทตามรูป */
                color: #ababab;
                /* สีตัวอักษรเทาอ่อน */
                font-family: 'Inter', sans-serif;
                /* แนะนำให้ใช้ Font แนวนี้ */
                padding-top: 60px;
                font-size: 14px;
                border-top: 1px solid #222;
                /* เส้นขอบบนบางๆ */
            }

            /* Container จัดกลาง */
            .footer-container {
                max-width: 1280px;
                margin: 0 auto;
                padding: 0 20px;
                display: flex;
                justify-content: space-between;
                flex-wrap: wrap;
                /* รองรับ Responsive */
            }

            /* --- ส่วนแบรนด์ด้านซ้าย --- */
            .footer-brand-section {
                flex: 1;
                min-width: 300px;
                margin-bottom: 40px;
                padding-right: 40px;
            }

            .footer-logo {
                font-size: 24px;
                font-weight: 800;
                color: #fff;
                text-transform: lowercase;
                margin-bottom: 10px;
                display: flex;
                align-items: center;
            }

            /* สไตล์โลโก้ 'ui' สีม่วง */
            .u-logo {
                background-color: #7827e6;
                /* สีม่วง */
                color: #fff;
                padding: 2px 6px;
                border-radius: 4px;
                margin-right: 2px;
                font-weight: 800;
            }

            .footer-tagline {
                margin-bottom: 20px;
                color: #888;
            }

            /* ส่วน License */
            .footer-license {
                margin-bottom: 25px;
                line-height: 1.6;
            }

            .footer-license i {
                color: #888;
                margin-right: 5px;
            }

            .footer-license strong {
                color: #fff;
            }

            .footer-license p {
                margin-top: 5px;
                color: #888;
                font-size: 13px;
            }

            /* ไอคอนโซเชียล */
            .footer-socials {
                display: flex;
                gap: 18px;
            }

            .footer-socials a {
                color: #888;
                font-size: 18px;
                transition: color 0.2s;
            }

            .footer-socials a:hover {
                color: #fff;
                /* เปลี่ยนเป็นสีขาวเมื่อชี้ */
            }

            /* --- ส่วนลิงก์ด้านขวา --- */
            .footer-links-section {
                flex: 2;
                display: flex;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 30px;
            }

            .footer-link-col {
                min-width: 120px;
            }

            /* หัวข้อคอลัมน์ */
            .footer-link-col h4 {
                color: #fff;
                font-weight: 600;
                margin-bottom: 20px;
                font-size: 15px;
            }

            .footer-link-col ul {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .footer-link-col ul li {
                margin-bottom: 12px;
            }

            /* สไตล์ลิงก์ */
            .footer-link-col ul li a {
                text-decoration: none;
                color: #ababab;
                transition: color 0.2s;
            }

            .footer-link-col ul li a:hover {
                color: #fff;
                /* เปลี่ยนเป็นสีขาวเมื่อชี้ */
                text-decoration: underline;
                /* เพิ่มเส้นใต้เมื่อชี้ */
            }

            /* --- ส่วนล่างสุด Copyright --- */
            .footer-bottom {
                margin-top: 40px;
                padding: 20px 0;
                border-top: 1px solid #1a1a1a;
                /* เส้นคั่น */
                font-size: 12px;
                color: #666;
            }

            .footer-bottom .footer-container {
                justify-content: flex-start;
                /* จัดซ้าย */
            }

            /* --- Responsive สำหรับมือถือ --- */
            @@media (max-width: 768px) {
                .footer-container {
                    flex-direction: column;
                }

                .footer-brand-section {
                    padding-right: 0;
                }

                .footer-links-section {
                    flex-direction: row;
                    gap: 20px;
                }

                .footer-link-col {
                    flex: 1 1 40%;
                    /* แสดง 2 คอลัมน์ต่อแถวบนมือถือ */
                }
            }

            .dropdown-menu {
                z-index: 99999 !important;
            }

            .custom-navbar {
                position: relative;
                z-index: 10000 !important;
            }


            .custom-navbar .dropdown,
            .custom-navbar .dropdown-toggle {
                z-index: 10001 !important;
            }

            .dropdown-menu-end {
                right: 0;
                left: auto;
            }

            .upload-box {
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
                gap: 6px;

                padding: 18px;
                border: 1px dashed #444;
                border-radius: 10px;
                background: #111;
                color: #aaa;

                cursor: pointer;
                transition: 0.2s;
            }

            .upload-box i {
                font-size: 20px;
            }

            .upload-box:hover {
                border-color: #7C3AED;
                color: #fff;
                background: #161618;
                box-shadow: 0 0 10px rgba(124, 58, 237, 0.3);
            }
    </style>
</head>

<body>
    <div class="hero-glow"></div>

    <header>
        <nav class="navbar navbar-expand-lg custom-navbar">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                Pixel<span>UI</span>
            </a>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto ms-lg-4">
                    @* เช็คว่าถ้าเป็น Admin Controller ให้แสดงเมนูแอดมิน *@
                    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Admin")
                    {
                        <li class="nav-item">
                            <a class="nav-link active text-white fw-bold" href="#">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="AddUser">
                                <i class="bi bi-person-plus me-1"></i> Add User
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                <i class="bi bi-people me-1"></i> Manage Users
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Admin" asp-action="Analytics">
                                <i class="bi bi-graph-up me-1"></i> Analytics
                            </a>
                        </li>
                        <li class="nav-item border-start ms-lg-3 ps-lg-3">
                            <a class="nav-link text-warning" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-arrow-left-circle me-1"></i> Back to Site
                            </a>
                        </li>
                    }
                    else
                    {
                        @* เมนูหน้าบ้านปกติของคุณ *@
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Product" asp-action="Browse">
                                <i class="bi bi-grid me-1"></i> Components
                            </a>
                        </li>
                        <li class="nav-item"><a class="nav-link" href="#">
                            <i class="bi bi-layout-text-window me-1"></i> Templates
                        </a>
                    </li>
                    <li class="nav-item"><a class="nav-link" href="#">
                        <i class="bi bi-currency-dollar me-1"></i> Pricing
                    </a>
                </li>
                <li class="nav-item"><a class="nav-link" href="#">
                    <i class="bi bi-file-earmark-text"></i> Docs
                </a>
            </li>

        }
    </ul>

    <div class="d-flex align-items-center">

        <div class="search-container ms-3">
            <i class="bi bi-search" style="font-size: 0.85rem;"></i>
            <input type="text" class="search-input" placeholder="PixelUI Search...">
        </div>

        <!-- Auth Buttons / User Info -->
        <div class="ms-4 d-flex align-items-center gap-3">
            @{
                var userId = Context.Session.GetString("UserId");
                var username = Context.Session.GetString("Username");
                var userRole = Context.Session.GetString("UserRole");
            }
                        
            @if (!string.IsNullOrEmpty(userId))
            {
                <div class="dropdown">
                    <a class="d-flex align-items-center gap-2 text-decoration-none dropdown-toggle" href="#"
                           role="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false"
                           style="cursor: pointer;">
            
                        <img src="https://ui-avatars.com/api/?name=@username&background=7C3AED&color=fff&rounded=true"
                             class="rounded-circle" style="width: 35px; height: 35px; border: 2px solid #7C3AED;"
                             alt="@username">
            
                        <div class="d-none d-sm-block">
                            <p class="user-info-username mb-0"
                               style="line-height: 1; font-weight: 600; color: #fff;">@username</p>
                            <small class="user-info-role"
                                   style="font-size: 0.7rem; color: #aaa;">@userRole</small>
                        </div>
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark shadow"
                        aria-labelledby="userDropdown"
                        style="background-color: #1a1a1a; border: 1px solid #333;">
                        <li>
                            <h6 class="dropdown-header">Manage Account</h6>
                        </li>
                        <li>
                            <a class="dropdown-item" href="@Url.Action("Profile", "User")">
                                <i class="bi bi-person-circle me-2"></i> My Profile
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="@Url.Action("MyPurchases", "User")">
                                <i class="bi bi-bag-check me-2"></i> My Purchases
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="@Url.Action("Downloads", "User")">
                                <i class="bi bi-download me-2"></i> Downloads
                            </a>
                        </li>
                        <li>
                            <hr class="dropdown-divider" style="background-color: #333;">
                        </li>
                        <li>
                            <a class="dropdown-item text-danger" href="@Url.Action("Logout", "Home")">
                                <i class="bi bi-box-arrow-right me-2"></i> Logout
                            </a>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <!-- NOT LOGGED IN -->
                <a href="@Url.Action("Login", "Home")" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                </a>
                <a href="@Url.Action("Register", "Home")" class="btn btn-dev btn-sm">
                    <i class="bi bi-person-plus me-1"></i> Register
                </a>
            }
                        
        </div>
    </div>
</div>
</nav>
</header>

<div class="container mt-5">
    <main role="main">
        @RenderBody()
    </main>
</div>


<footer class="main-footer">
    <div class="footer-container">
        <div class="footer-brand-section">
            <div class="footer-logo">
                Pixel<span class="u-logo">UI</span>
            </div>
            <p class="footer-tagline">Uiverse | The universe of UI</p>



            <div class="footer-socials">
                <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                <a href="#" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                <a href="#" aria-label="Discord"><i class="fab fa-discord"></i></a>
            </div>
        </div>

        <div class="footer-links-section">


            <div class="footer-link-col">
                <h4>Resources</h4>
                <ul>
                    <li><a href="#"> PixelUI.io</a></li>
                    <li><a href="#">gemini.google.com</a></li>
                </ul>
            </div>

            <div class="footer-link-col">
                <h4>Information</h4>
                <ul>
                    <li><a href="#">Blog</a></li>
                    <li><a href="#">Post Guidelines</a></li>
                    <li><a href="#">Give feedback</a></li>
                    <li><a asp-controller="Home" asp-action="ReportBug">Report bug</a></li>
                </ul>
            </div>

            <div class="footer-link-col">
                <h4>Legal</h4>
                <ul>
                    <li><a href="#">Terms and Conditions</a></li>
                    <li><a href="#">Privacy policy</a></li>
                    <li><a href="#">Cookie policy</a></li>
                    <li><a href="#">Disclaimer</a></li>
                </ul>
            </div>

            <div class="footer-link-col">
                <h4>Support Center</h4>

                <form method="post" action="/Home/CreateTicket" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input name="subject" placeholder="Subject" class="form-control mb-2" required
                           style="background:#111; border:1px solid #333; color:white;">

                    <textarea name="message" placeholder="Describe your issue..." class="form-control mb-2" required
                              style="background:#111; border:1px solid #333; color:white;"></textarea>

                    <div style="display:flex; gap:8px; align-items:center; margin-bottom:10px;">
    
                        <label class="btn btn-outline-secondary btn-sm" for="attachmentInput">
                            <i class="bi bi-paperclip"></i> Attach Image
                        </label>

                        <input type="file" id="attachmentInput" name="attachment" accept="image/*"
                               style="display:none;" />

                        <span id="fileName" style="
                            font-size:12px;
                            color:#aaa;
                            max-width:120px;
                            white-space:nowrap;
                            overflow:hidden;
                            text-overflow:ellipsis;
                            display:inline-block;
                            ">
                        </span>
                    </div>

                    <button type="submit" class="btn btn-dev w-100">
                        <i class="bi bi-send"></i> Send Ticket
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="footer-bottom">
        <div class="footer-container">
            <p>Project PixelUI CSI402</p>
        </div>
    </div>




</footer>

  
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const input = document.getElementById('attachmentInput');
    const fileName = document.getElementById('fileName');

    if (input) {
    input.addEventListener('change', function () {
    fileName.textContent = input.files[0]?.name || '';
    });
    }
</script>

@RenderSection("Scripts", required: false)

</body>

</html>